---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/portfolio/Nav.astro';
import Hero from '../components/portfolio/Hero.astro';
import SkillsBento from '../components/portfolio/SkillsBento.astro';
import Projects from '../components/portfolio/Projects.astro';
import Contact from '../components/portfolio/Contact.astro';

const title = 'SanchoDev | Software Engineer';
const description =
  'Portafolio de Santiago Sánchez Márquez';
---

<BaseLayout title={title} description={description}>
  <Nav />
  <main>
    <Hero />
    <SkillsBento />
    <Projects />
    <Contact />
  </main>
</BaseLayout>

<style is:global>
  /* Smooth scroll para los anclas del Nav, respetando preferencias de movimiento reducido. */
  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }
</style>
