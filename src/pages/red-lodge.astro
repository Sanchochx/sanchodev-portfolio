---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Red Lodge" description="RED LODGE: escritorio interactivo de Santiago Sánchez Márquez.">
  <!-- Ocultamos el Navbar global y el Footer por defecto de esta página mediante CSS -->
  <style is:global>
    header, nav, footer, #chat-widget { display: none !important; }
    body { overflow: hidden; } /* Evita el scroll en el escritorio */

    @keyframes psychedelic-rainbow {
      0% { filter: hue-rotate(0deg) saturate(200%); }
      50% { filter: hue-rotate(180deg) saturate(300%) brightness(1.2); }
      100% { filter: hue-rotate(360deg) saturate(200%); }
    }

    @keyframes psychedelic-glow {
      0% { text-shadow: 0 0 10px #ff0000, 0 0 20px #ff00ff; }
      33% { text-shadow: 0 0 10px #00ff00, 0 0 20px #00ffff; }
      66% { text-shadow: 0 0 10px #0000ff, 0 0 20px #ff00ff; }
      100% { text-shadow: 0 0 10px #ff0000, 0 0 20px #ff00ff; }
    }

    @keyframes rainbow-hue {
      from { filter: hue-rotate(0deg); }
      to { filter: hue-rotate(360deg); }
    }

    /* Texto con degradado arcoíris; el filtro rota el tono para que cambie de color */
    .rainbow-text,
    .rainbow-text * {
      color: transparent !important;
    }
    .rainbow-text {
      background-image: linear-gradient(90deg, #ff0040, #ff8000, #ffe600, #00e060, #00c8ff, #8000ff, #ff0040);
      -webkit-background-clip: text;
      background-clip: text;
    }

    /* Solo se animan si el usuario no pidió reducir movimiento */
    @media (prefers-reduced-motion: no-preference) {
      .rainbow-text { animation: rainbow-hue 0.6s linear infinite; }
      .psychedelic-container { animation: psychedelic-rainbow 4s linear infinite; }
      .psychedelic-text { animation: psychedelic-glow 3s ease-in-out infinite; }
    }
  </style>

  <script is:inline src="https://js-dos.com/6.22/current/js-dos.js"></script>

  <main class="h-screen w-full relative z-10 flex flex-col">
    <!-- Pantalla de BIOS / Boot Screen -->
    <div id="bios-screen" class="absolute inset-0 bg-black z-[60] flex flex-col justify-between p-6 font-mono text-cyan-400 text-xs md:text-sm select-none overflow-hidden psychedelic-container">
      <!-- Scanlines retro y capa de distorsión cromática -->
      <div class="absolute inset-0 pointer-events-none bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(255,0,255,0.1)_50%)] bg-[length:100%_4px] z-10" aria-hidden="true"></div>

      <!-- Los logs se anclan abajo; lo que desborda por arriba queda recortado -->
      <div class="relative z-20 h-full overflow-hidden flex flex-col justify-end">
        <div class="space-y-1 psychedelic-text">
          <p class="text-pink-500 font-bold">CYBER-PSYCHEDELIC BIOS v9.99 (c) 2026 Mainframe Matrix</p>
          <p class="text-purple-400">QUANTUM CORE: HYPER-DIMENSIONAL NEURAL ARRAY @ 9.00THz</p>
          <p id="bios-memory" class="text-green-400">VIRTUAL MEMORY MATRIX : 0K</p>
          <p class="text-yellow-400">AUTO-DETECTING NEURAL SLAVE: ACID_WASM_ENGINE_v7</p>
          <p class="text-cyan-400">HUE SHIFT MATRIX: ACTIVE // RAINBOW OVERLOAD</p>
        </div>
        <div id="dynamic-boot-logs" class="space-y-1 mt-1 text-emerald-300"></div>
      </div>

      <div class="relative z-20 pt-4 border-t border-purple-500/40 text-[10px] md:text-xs text-pink-400 flex justify-between uppercase tracking-widest font-bold">
        <span id="boot-status" class="motion-safe:animate-pulse">STATUS: WARPING REALITY...</span>      </div>
    </div>

    <!-- Área del escritorio -->
    <div class="flex-1 relative w-full h-full p-4 flex flex-col flex-wrap content-start gap-2">

      <!-- Icono: My Portfolio (Acceso Directo) -->
      <a href="/" class="w-20 flex flex-col items-center justify-start group rounded-sm border border-transparent hover:bg-blue-500/20 hover:border-blue-400/30 transition-colors p-1 cursor-pointer z-20">
        <div class="relative w-9 h-9 mb-1">
          <!-- Icono principal -->
          <img src="/images/sanchodev_logo.png" alt="My Portfolio" class="w-full h-full object-contain drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]" />

          <!-- Flechita de acceso directo (estilo clásico) -->
          <div class="absolute -bottom-1 -left-1 w-3 h-3 bg-white border border-gray-400 flex items-center justify-center shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#0066cc" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 5l7 7-7 7" />
              <path d="M17 12H3" />
            </svg>
          </div>
        </div>

        <!-- Texto del icono -->
        <span class="text-white text-[9px] text-center font-mono tracking-wider drop-shadow-[0_1px_3px_rgba(0,0,0,1)] px-1 leading-tight mt-1">
          My Portfolio
        </span>
      </a>

      <!-- Icono: Bloc de notas -->
      <button id="notepad-icon" type="button" class="w-20 flex flex-col items-center justify-start group rounded-sm border border-transparent hover:bg-blue-500/20 hover:border-blue-400/30 focus-visible:border-blue-400/60 transition-colors p-1 cursor-pointer z-20">
        <div class="relative w-9 h-9 mb-1">
          <img src="/images/notepad_icon.png" alt="Notepad" width="36" height="36" class="w-full h-full object-contain drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]" onerror="this.onerror=null;this.src='/images/sanchodev_logo.png'" />
          <div class="absolute -bottom-1 -left-1 w-3 h-3 bg-white border border-gray-400 flex items-center justify-center shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#0066cc" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 5l7 7-7 7" />
              <path d="M17 12H3" />
            </svg>
          </div>
        </div>
        <span class="text-white text-[9px] text-center font-mono tracking-wider drop-shadow-[0_1px_3px_rgba(0,0,0,1)] px-1 leading-tight mt-1">
          About Me
        </span>
      </button>

      <!-- Icono: MS Paint -->
      <button id="paint-icon" type="button" class="w-20 flex flex-col items-center justify-start group rounded-sm border border-transparent hover:bg-blue-500/20 hover:border-blue-400/30 focus-visible:border-blue-400/60 transition-colors p-1 cursor-pointer z-20">
        <div class="relative w-9 h-9 mb-1">
          <img src="/images/paint_icon.png" alt="MS Paint" width="36" height="36" class="w-full h-full object-contain drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]" onerror="this.onerror=null;this.src='/images/sanchodev_logo.png'" />
          <div class="absolute -bottom-1 -left-1 w-3 h-3 bg-white border border-gray-400 flex items-center justify-center shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#0066cc" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 5l7 7-7 7" />
              <path d="M17 12H3" />
            </svg>
          </div>
        </div>
        <span class="text-white text-[9px] text-center font-mono tracking-wider drop-shadow-[0_1px_3px_rgba(0,0,0,1)] px-1 leading-tight mt-1">
          MS PAINT
        </span>
      </button>

      <!-- Icono: DOOM -->
      <button id="doom-icon" type="button" class="w-20 flex flex-col items-center justify-start group rounded-sm border border-transparent hover:bg-blue-500/20 hover:border-blue-400/30 focus-visible:border-blue-400/60 transition-colors p-1 cursor-pointer z-20">
        <div class="relative w-9 h-9 mb-1">
          <img src="/images/doom_icon.png" alt="DOOM" width="36" height="36" class="w-full h-full object-contain drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]" onerror="this.onerror=null;this.src='/images/sanchodev_logo.png'" />
          <div class="absolute -bottom-1 -left-1 w-3 h-3 bg-white border border-gray-400 flex items-center justify-center shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#0066cc" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 5l7 7-7 7" />
              <path d="M17 12H3" />
            </svg>
          </div>
        </div>
        <span class="text-white text-[9px] text-center font-mono tracking-wider drop-shadow-[0_1px_3px_rgba(0,0,0,1)] px-1 leading-tight mt-1">
          DOOM
        </span>
      </button>

      <!-- Icono: 3D Pinball -->
      <button id="pinball-icon" type="button" class="w-20 flex flex-col items-center justify-start group rounded-sm border border-transparent hover:bg-blue-500/20 hover:border-blue-400/30 focus-visible:border-blue-400/60 transition-colors p-1 cursor-pointer z-20">
        <div class="relative w-9 h-9 mb-1">
          <img src="/images/pinball_icon.png" alt="3D Pinball" width="36" height="36" class="w-full h-full object-contain drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]" onerror="this.onerror=null;this.src='/images/sanchodev_logo.png'" />
          <div class="absolute -bottom-1 -left-1 w-3 h-3 bg-white border border-gray-400 flex items-center justify-center shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#0066cc" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 5l7 7-7 7" />
              <path d="M17 12H3" />
            </svg>
          </div>
        </div>
        <span class="text-white text-[9px] text-center font-mono tracking-wider drop-shadow-[0_1px_3px_rgba(0,0,0,1)] px-1 leading-tight mt-1">
          3D Pinball
        </span>
      </button>

      <!-- Icono: Wolfenstein 3D -->
      <button id="wolf-icon" type="button" class="w-20 flex flex-col items-center justify-start group rounded-sm border border-transparent hover:bg-blue-500/20 hover:border-blue-400/30 focus-visible:border-blue-400/60 transition-colors p-1 cursor-pointer z-20">
        <div class="relative w-9 h-9 mb-1">
          <img src="/images/wolf_icon.png" alt="Wolfenstein 3D" width="36" height="36" class="w-full h-full object-contain drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]" onerror="this.onerror=null;this.src='/images/sanchodev_logo.png'" />
          <div class="absolute -bottom-1 -left-1 w-3 h-3 bg-white border border-gray-400 flex items-center justify-center shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#0066cc" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 5l7 7-7 7" />
              <path d="M17 12H3" />
            </svg>
          </div>
        </div>
        <span class="text-white text-[9px] text-center font-mono tracking-wider drop-shadow-[0_1px_3px_rgba(0,0,0,1)] px-1 leading-tight mt-1">
          WOLFENSTEIN 3D
        </span>
      </button>

    </div>

    <!-- Ventana de DOOM (oculta por defecto) -->
    <div id="doom-window" class="hidden fixed inset-0 m-auto h-fit w-[min(800px,95vw,calc((100vh-4rem)*1.6))] bg-black border border-red-900 rounded-sm shadow-2xl z-40 flex flex-col">
      <div class="h-8 bg-black flex items-center justify-between px-2 select-none border-b border-red-900">
        <div class="flex items-center text-red-600 text-xs font-mono tracking-wider">
          <img src="/images/doom_icon.png" alt="" width="16" height="16" class="w-4 h-4 mr-2" onerror="this.style.display='none'" />
          js-dos - DOOM
        </div>
        <button id="doom-close" type="button" aria-label="Cerrar DOOM" class="w-6 h-6 hover:bg-red-500 focus-visible:bg-red-500 text-red-600 hover:text-white flex items-center justify-center text-xs">✕</button>
      </div>
      <div class="w-full aspect-[16/10] bg-black relative" id="dos-container">
        <canvas id="jsdos" class="!w-full !h-full block object-contain"></canvas>
      </div>
    </div>

    <!-- Ventana de Pinball (oculta por defecto) -->
    <div id="pinball-window" class="hidden fixed inset-0 m-auto h-[min(720px,calc(100vh-4rem))] w-[min(960px,95vw)] bg-black border border-red-900 rounded-sm shadow-2xl z-40 flex flex-col">
      <div class="h-8 shrink-0 bg-black flex items-center justify-between px-2 select-none border-b border-red-900">
        <div class="flex items-center text-red-600 text-xs font-mono tracking-wider">
          <img src="/images/pinball_icon.png" alt="" width="16" height="16" class="w-4 h-4 mr-2" onerror="this.style.display='none'" />
          3D Pinball for Windows - Space Cadet
        </div>
        <button id="pinball-close" type="button" aria-label="Cerrar 3D Pinball" class="w-6 h-6 hover:bg-red-500 focus-visible:bg-red-500 text-red-600 hover:text-white flex items-center justify-center text-xs">✕</button>
      </div>
      <!-- El iframe se inyecta por JS para que no consuma recursos en segundo plano -->
      <div class="flex-1 w-full bg-black relative" id="pinball-container"></div>
    </div>

    <!-- Ventana de Wolfenstein 3D (oculta por defecto) -->
    <div id="wolf-window" class="hidden fixed inset-0 m-auto h-fit w-[min(800px,95vw,calc((100vh-4rem)*1.6))] bg-black border border-red-900 rounded-sm shadow-2xl z-40 flex flex-col">
      <div class="h-8 bg-black flex items-center justify-between px-2 select-none border-b border-red-900">
        <div class="flex items-center text-red-600 text-xs font-mono tracking-wider">
          <img src="/images/wolf_icon.png" alt="" width="16" height="16" class="w-4 h-4 mr-2" onerror="this.style.display='none'" />
          js-dos - Wolfenstein 3D
        </div>
        <button id="wolf-close" type="button" aria-label="Cerrar Wolfenstein 3D" class="w-6 h-6 hover:bg-red-500 focus-visible:bg-red-500 text-red-600 hover:text-white flex items-center justify-center text-xs">✕</button>
      </div>
      <div class="w-full aspect-[16/10] bg-black relative" id="wolf-container">
        <canvas id="jsdos-wolf" class="!w-full !h-full block object-contain"></canvas>
      </div>
    </div>

    <!-- Ventana de Bloc de notas (oculta por defecto) -->
    <div id="notepad-window" class="hidden fixed inset-0 m-auto h-[min(480px,calc(100vh-4rem))] w-[min(760px,95vw)] bg-black border border-red-900 rounded-sm shadow-2xl z-40 flex flex-col font-mono">
      <div id="notepad-titlebar" class="h-8 shrink-0 bg-black flex items-center justify-between px-2 select-none border-b border-red-900 cursor-move touch-none">
        <div class="flex items-center text-red-600 text-xs font-mono tracking-wider">
          <img src="/images/notepad_icon.png" alt="" width="16" height="16" class="w-4 h-4 mr-2" onerror="this.style.display='none'" />
          About Me - Notepad
        </div>
        <button id="notepad-close" type="button" aria-label="Cerrar Bloc de notas" class="w-6 h-6 hover:bg-red-500 focus-visible:bg-red-500 text-red-600 hover:text-white flex items-center justify-center text-xs">✕</button>
      </div>
      <div class="shrink-0 bg-black text-gray-300 text-[11px] px-2 py-1 flex space-x-4 border-b border-red-900/50 select-none" aria-hidden="true">
        <span class="px-1">File</span>
        <span class="px-1">Edit</span>
        <span class="px-1">Format</span>
        <span class="px-1">View</span>
        <span class="px-1">Help</span>
      </div>
      <div class="flex-1 bg-black text-gray-300 p-4 text-xs md:text-sm overflow-y-auto selection:bg-green-800 selection:text-white leading-relaxed font-sans">
        <div class="flex flex-col sm:flex-row gap-4 sm:gap-6">
          <div class="sm:w-[68%] text-justify break-words space-y-4">
            <p>I'm SanchoDev. I'm a software engineer I love computers, technology, building and maintaining software. From a young age, I've been on the internet and playing videogames. That curiosity naturally evolved into a passion for software development. Right now, I'm on a self-taught journey to specialize as a Cloud and DevOps engineer.</p>
            <p>This is my personal corner of the internet—a space where I'll keep adding stuff that represent who I am and I like. I also do videogame and movie reviews, which you can find on this Desktop. Feel free to use this portfolio as inspiration for your own work.</p>
            <p>If you'd like to connect or collaborate, just email me at <a href="mailto:santiagosanchezmarquez@gmail.com" class="text-green-400 underline hover:text-green-300 focus-visible:outline focus-visible:outline-1 focus-visible:outline-green-400">santiagosanchezmarquez@gmail.com</a>. I value my privacy, but since I'm looking for a job I need to share just a bit unfortunately.</p>
            <section aria-labelledby="sw-hw-title" class="rainbow-text text-left pt-4">
              <h2 id="sw-hw-title" class="font-mono text-xs tracking-wider text-gray-500 mb-3">=== SOFTWARE &amp; HARDWARE ===</h2>
              <p class="font-semibold text-gray-200 mb-1">Personal Laptop (Acer Nitro V15)</p>
              <dl class="grid grid-cols-1 sm:grid-cols-[auto_1fr] gap-x-4 gap-y-1 mb-3">
                <dt class="font-bold text-gray-200">Processor:</dt>
                <dd class="mb-2 sm:mb-0">13th Gen Intel(R) Core(TM) i7-13620H (2.40 GHz)</dd>
                <dt class="font-bold text-gray-200">Installed RAM:</dt>
                <dd class="mb-2 sm:mb-0">16.0 GB (15.7 GB usable)</dd>
                <dt class="font-bold text-gray-200">Graphics card:</dt>
                <dd class="mb-2 sm:mb-0">NVIDIA GeForce RTX 4050 Laptop GPU (6 GB) / Intel(R) UHD Graphics (128 MB)</dd>
              </dl>
              <dl class="grid grid-cols-1 sm:grid-cols-[auto_1fr] gap-x-4 gap-y-1 mb-3">
                <dt class="font-bold text-gray-200">Work Device:</dt>
                <dd>Currently a Virtual Box with Ubuntu, but in the future a Lenovo T480. <span class="font-mono text-xs italic text-gray-500">// Only og developers know that jam ;)</span></dd>
              </dl>
            </section>
          </div>
          <!-- En móvil la imagen queda arriba del texto -->
          <figure class="order-first sm:order-last sm:w-[32%] shrink-0 self-start mx-auto w-48 sm:mx-0 border border-gray-600 shadow-lg">
            <img src="/images/avatar.jpeg" alt="Santiago Sánchez Márquez" width="240" height="240" class="w-full aspect-square object-cover block" />          </figure>
        </div>

        <p class="text-gray-500 mt-6 text-xs font-mono">[ End of file - Read Only Mode ]</p>
      </div>
    </div>

    <!-- Ventana de MS Paint, estilo Windows 95 (oculta por defecto) -->
    <div id="paint-window" class="hidden fixed inset-0 m-auto h-fit w-[min(660px,95vw)] bg-[#c0c0c0] border-2 border-t-white border-l-white border-b-black border-r-black shadow-2xl z-40 flex flex-col font-sans select-none text-black">
      <div id="paint-titlebar" class="h-7 shrink-0 bg-gradient-to-r from-[#000080] to-[#1084d0] flex items-center justify-between px-2 cursor-move touch-none">
        <div class="flex items-center text-white text-xs font-bold tracking-wide">
          <img src="/images/paint_icon.png" alt="" width="16" height="16" class="w-4 h-4 mr-2" onerror="this.style.display='none'" />
          Paint
        </div>
        <div class="flex space-x-1">
          <button type="button" aria-label="Minimize" class="w-5 h-5 bg-[#c0c0c0] border-t border-l border-white border-b-2 border-r-2 border-black text-black flex items-center justify-center text-xs font-bold active:border-t-2 active:border-l-2 active:border-b-white active:border-r-white">_</button>
          <button type="button" aria-label="Maximize" class="w-5 h-5 bg-[#c0c0c0] border-t border-l border-white border-b-2 border-r-2 border-black text-black flex items-center justify-center text-xs font-bold active:border-t-2 active:border-l-2 active:border-b-white active:border-r-white">□</button>
          <button id="paint-close" type="button" aria-label="Close Paint" class="w-5 h-5 bg-[#c0c0c0] border-t border-l border-white border-b-2 border-r-2 border-black text-black flex items-center justify-center text-xs font-bold active:border-t-2 active:border-l-2 active:border-b-white active:border-r-white">✕</button>
        </div>
      </div>

      <div class="bg-[#c0c0c0] text-black text-xs px-2 py-0.5 flex space-x-3 border-b border-[#808080]">
        <div class="relative" id="paint-file-menu">
          <button id="paint-file-btn" type="button" aria-haspopup="true" aria-expanded="false" class="px-1 hover:bg-[#000080] hover:text-white focus-visible:bg-[#000080] focus-visible:text-white aria-expanded:bg-[#000080] aria-expanded:text-white"><u>F</u>ile</button>
          <div id="paint-file-dropdown" role="menu" class="hidden absolute left-0 top-full z-50 min-w-[9rem] bg-[#c0c0c0] border-2 border-t-white border-l-white border-b-black border-r-black py-0.5 shadow-md">
            <button id="paint-save" type="button" role="menuitem" class="w-full text-left px-6 py-0.5 hover:bg-[#000080] hover:text-white focus-visible:bg-[#000080] focus-visible:text-white">Save Image</button>
          </div>
        </div>
        <button id="paint-clear" type="button" class="hover:bg-[#000080] hover:text-white focus-visible:bg-[#000080] focus-visible:text-white px-1"><u>C</u>lear</button>
      </div>

      <div class="flex p-2 bg-[#c0c0c0] gap-2">
        <div class="w-16 shrink-0 grid grid-cols-2 gap-1 bg-[#c0c0c0] p-1 border-t border-l border-[#808080] border-b border-r border-white h-fit">
          <button type="button" data-tool="eraser" id="paint-tool-eraser" title="Eraser" aria-label="Eraser" class="paint-tool p-1.5 flex items-center justify-center text-xs">⬜</button>
          <button type="button" data-tool="fill" id="paint-tool-fill" title="Fill with color" aria-label="Fill with color" class="paint-tool p-1.5 flex items-center justify-center text-xs">🪣</button>
          <button type="button" data-tool="picker" id="paint-tool-picker" title="Color picker" aria-label="Color picker" class="paint-tool p-1.5 flex items-center justify-center text-xs">💉</button>
          <button type="button" data-tool="pencil" id="paint-tool-pencil" title="Pencil" aria-label="Pencil" class="paint-tool p-1.5 flex items-center justify-center text-xs">✏️</button>
          <button type="button" data-tool="brush" id="paint-tool-brush" title="Brush" aria-label="Brush" class="paint-tool p-1.5 flex items-center justify-center text-xs">🖌️</button>
        </div>

        <div class="flex-1 min-w-0 bg-white border-2 border-t-[#808080] border-l-[#808080] border-b-white border-r-white relative overflow-hidden h-[340px] max-h-[50vh]" id="paint-canvas-wrap">
          <canvas id="paint-canvas" class="w-full h-full cursor-crosshair touch-none"></canvas>
        </div>
