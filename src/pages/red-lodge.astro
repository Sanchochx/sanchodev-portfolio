  <!-- Secuencia de arranque: BIOS -> escritorio -->
  <script>
    const MEMORY_TOTAL_K = 131072;
    const BIOS_DURATION_MS = 3200;
    const LOG_INTERVAL_MS = 120;
    const FADE_MS = 400;
    const LOG_COLORS: string[] = ['text-pink-400', 'text-yellow-300', 'text-cyan-300', 'text-purple-400', 'text-green-300'];

    const biosScreen = document.getElementById('bios-screen');
    const logContainer = document.getElementById('dynamic-boot-logs');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function setText(id: string, text: string): void {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    }

    function hex(value: number, digits: number): string {
      return value.toString(16).toUpperCase().padStart(digits, '0');
    }

    function randomHex(digits: number): string {
      return hex(Math.floor(Math.random() * 16 ** digits), digits);
    }

    // Los timestamps crecen con el índice para que el log parezca un dmesg real
    const bootSteps: string[] = [
      'Linux version 6.8.0-red-lodge (sancho@mainframe) #1 SMP PREEMPT',
      'Command_Line: BOOT_IMAGE=/boot/vmlinuz-red root=/dev/nvme0n1p2 ro quiet',
      'BIOS-provided physical RAM map:',
      'BIOS-e820: [mem 0x0000000000000000-0x000000000009FBFF] usable',
      'BIOS-e820: [mem 0x0000000000100000-0x00000000BFFDFFFF] usable',
      'BIOS-e820: [mem 0x00000000FEC00000-0x00000000FEC00FFF] reserved',
      'x86/fpu: Supporting FPU state: 0x500, descriptors: 4, datamask: 0x7',
      'ACPI: RSDP 0x00000000000F6A40 000024 (v02 RLODGE)',
      'ACPI: XSDT 0x00000000BFFE1830 00004C (v01 RLODGE RLTABLE)',
      'ACPI: FACP 0x00000000BFFE16D0 000114 (v06 RLODGE RLTABLE)',
      'Zone ranges: DMA [mem 0x1000-0xFFFFFF] DMA32 [mem 0x1000000-0xFFFFFFFF]',
      'percpu: Embedded 62 pages/cpu s217088 r8192 d28672 u262144',
      'zswap: loaded pool lzo-optimized compressor',
      'NET: Registered PF_INET protocol family',
      'PCI: MMCONFIG at [mem 0xE0000000-0xEFFFFFFF] reserved as E820 entry',
      'nvme nvme0: pci function 0000:01:00.0',
      'EXT4-fs (nvme0n1p2): mounted filesystem with ordered data mode',
      'systemd[1]: Detected architecture x86-64.',
      'Initializing WebAssembly Virtual Machine Sandbox...',
      'wasm: heap base @ 0x__HEX__ stack guard @ 0x__HEX__',
      'Loading module: [ DOOM_ENGINE_V7 ] ... [SUCCESS]',
      'Loading module: [ SPACE_CADET_PINBALL_WASM ] ... [SUCCESS]',
      'Loading module: [ WOLFENSTEIN_3D_RAYCASTER ] ... [SUCCESS]',
      'Mounting virtual file systems and opening RED_LODGE desktop environment...',
      'SYSTEM READY. LAUNCHING DESKTOP INTERFACE...',
    ];

    function appendLog(index: number): void {
      if (!logContainer) return;
      const seconds = ((index / bootSteps.length) * (BIOS_DURATION_MS / 1000 - 0.4)).toFixed(6).padStart(9, ' ');
      const text = bootSteps[index].replace(/__HEX__/g, () => randomHex(16));
      const line = document.createElement('p');
      line.className = `${LOG_COLORS[index % LOG_COLORS.length]} whitespace-nowrap`;
      line.textContent = `[${seconds}] ${text}`;
      logContainer.appendChild(line);
    }

    if (biosScreen) {
      // Conteo de memoria
      const start = performance.now();
      const memTimer = window.setInterval(() => {
        const progress = Math.min((performance.now() - start) / (BIOS_DURATION_MS * 0.5), 1);
        const done = progress === 1;
        setText('bios-memory', 'VIRTUAL MEMORY MATRIX : ' + Math.round(MEMORY_TOTAL_K * progress) + 'K' + (done ? ' UNBOUND [OK]' : ''));
        if (done) window.clearInterval(memTimer);
      }, 40);

      // Logs progresivos; con reduced-motion se vuelcan de una vez
      let logIndex = 0;
      if (reducedMotion) {
        for (; logIndex < bootSteps.length; logIndex++) appendLog(logIndex);
      } else {
        const logTimer = window.setInterval(() => {
          if (logIndex >= bootSteps.length) {
            window.clearInterval(logTimer);
            return;
          }
          appendLog(logIndex++);
        }, LOG_INTERVAL_MS);
      }

      window.setTimeout(() => setText('boot-status', 'STATUS: REALITY WARPED'), BIOS_DURATION_MS - 600);

      window.setTimeout(() => {
        biosScreen.style.transition = reducedMotion ? 'none' : `opacity ${FADE_MS}ms ease-in-out`;
        biosScreen.style.opacity = '0';
        window.setTimeout(() => { biosScreen.style.display = 'none'; }, reducedMotion ? 0 : FADE_MS);
      }, BIOS_DURATION_MS);
    }
  </script>

  <!-- Script para actualizar el reloj en tiempo real -->
  <script>
    function updateClock(): void {
      const clockElement = document.getElementById('os-clock');
      if (clockElement) {
        const now = new Date();
        const hours = now.getHours();
        const minutes = now.getMinutes();
        const ampm = hours >= 12 ? 'PM' : 'AM';
        const hours12 = hours % 12 || 12;
        const minutesStr = minutes < 10 ? '0' + minutes : String(minutes);

        const date = now.toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric' });

        clockElement.textContent = hours12 + ':' + minutesStr + ' ' + ampm + '  ' + date;
      }
    }

    setInterval(updateClock, 1000);
    updateClock();
  </script>
  <script>
    interface DosCommandInterface { exit(): Promise<void>; }
    interface DosFs { extract(url: string): Promise<void>; }
    type DosMain = (args: string[]) => Promise<DosCommandInterface>;
    interface DosBoot { ready(cb: (fs: DosFs, main: DosMain) => void): void; }
    type DosFactory = (canvas: HTMLCanvasElement, opts: { wdosboxUrl: string }) => DosBoot;

    let dosInstance: DosCommandInterface | null = null;
    let booting = false;

    // js-dos reescribe document.title al arrancar/cerrar; lo restauramos.
    const pageTitle = document.title;
    const titleEl = document.querySelector('title');
    if (titleEl) {
      new MutationObserver(() => {
        if (document.title !== pageTitle) document.title = pageTitle;
      }).observe(titleEl, { childList: true, characterData: true, subtree: true });
    }

    function openDoom(): void {
      const win = document.getElementById('doom-window');
      const canvas = document.getElementById('jsdos') as HTMLCanvasElement | null;
      const Dos = (window as unknown as { Dos?: DosFactory }).Dos;
      if (!win || !canvas) return;
      win.classList.remove('hidden');

      if (dosInstance || booting || !Dos) return;
      booting = true;
      Dos(canvas, { wdosboxUrl: 'https://js-dos.com/6.22/current/wdosbox.js' }).ready((fs, main) => {
        fs.extract('https://js-dos.com/cdn/upload/DOOM-@evilution.zip')
          .then(() => main(['-c', 'cd DOOM', '-c', 'DOOM.EXE']))
          .then((ci) => {
            // La ventana pudo cerrarse mientras cargaba
            if (win.classList.contains('hidden')) void ci.exit();
            else dosInstance = ci;
          })
          .catch((err) => console.error('DOOM failed to start', err))
          .finally(() => { booting = false; });
      });
    }

    function closeDoom(): void {
      document.getElementById('doom-window')?.classList.add('hidden');
      const container = document.getElementById('dos-container');
      if (!dosInstance || !container) return;
      void dosInstance.exit();
      dosInstance = null;
      container.innerHTML = '<canvas id="jsdos" class="!w-full !h-full block object-contain"></canvas>';
    }

    const icon = document.getElementById('doom-icon');
    icon?.addEventListener('dblclick', openDoom);
    icon?.addEventListener('keydown', (e) => { if (e.key === 'Enter') openDoom(); });
    document.getElementById('doom-close')?.addEventListener('click', closeDoom);
  </script>
