        <div class="flex items-center text-red-600 text-xs font-mono tracking-wider truncate">
          Chaos Faction 2
        </div>
        <button id="chaos-close" type="button" aria-label="Cerrar Chaos Faction 2" class="w-6 h-6 hover:bg-red-500 focus-visible:bg-red-500 text-red-600 hover:text-white flex items-center justify-center text-xs">✕</button>
      </div>
      <!-- Ruffle se inyecta por JS para que no consuma recursos en segundo plano -->
      <div class="flex-1 w-full bg-black relative" id="chaos-container"></div>
    </div>

    <!-- Ventana de DOOM (oculta por defecto) -->
    <div id="doom-window" class="hidden fixed inset-0 m-auto h-fit w-[min(800px,95vw,calc((100vh-4rem)*1.6))] bg-black border border-red-900 rounded-sm shadow-2xl z-40 flex flex-col">
      <div class="h-8 bg-black flex items-center justify-between px-2 select-none border-b border-red-900">
        <div class="flex items-center text-red-600 text-xs font-mono tracking-wider">
          <img src="/images/doom_icon.png" alt="" width="16" height="16" class="w-4 h-4 mr-2" onerror="this.style.display='none'" />
          js-dos - DOOM
        </div>
        <button id="doom-close" type="button" aria-label="Cerrar DOOM" class="w-6 h-6 hover:bg-red-500 focus-visible:bg-red-500 text-red-600 hover:text-white flex items-center justify-center text-xs"><span class="rainbow-text">✕</span></button>
      </div>
      <div class="w-full aspect-[16/10] bg-black relative" id="dos-container">
        <canvas id="jsdos" class="!w-full !h-full block object-contain"></canvas>
      </div>
    </div>

    <!-- Ventana de Pinball (oculta por defecto) -->
    <div id="pinball-window" class="hidden fixed inset-0 m-auto h-[min(720px,calc(100vh-4rem))] w-[min(960px,95vw)] bg-black border border-red-900 rounded-sm shadow-2xl z-40 flex flex-col">
      <div class="h-8 shrink-0 bg-black flex items-center justify-between px-2 select-none border-b border-red-900">
        <div class="flex items-center text-red-600 text-xs font-mono tracking-wider">
          <img src="/images/pinball_icon.png" alt="" width="16" height="16" class="w-4 h-4 mr-2" onerror="this.style.display='none'" />
          3D Pinball for Windows - Space Cadet
        </div>
        <button id="pinball-close" type="button" aria-label="Cerrar 3D Pinball" class="w-6 h-6 hover:bg-red-500 focus-visible:bg-red-500 text-red-600 hover:text-white flex items-center justify-center text-xs">✕</button>
      </div>
      <!-- El iframe se inyecta por JS para que no consuma recursos en segundo plano -->
      <div class="flex-1 w-full bg-black relative" id="pinball-container"></div>
    </div>

    <!-- Ventana de Wolfenstein 3D (oculta por defecto) -->
    <div id="wolf-window" class="hidden fixed inset-0 m-auto h-fit w-[min(800px,95vw,calc((100vh-4rem)*1.6))] bg-black border border-red-900 rounded-sm shadow-2xl z-40 flex flex-col">
      <div class="h-8 bg-black flex items-center justify-between px-2 select-none border-b border-red-900">
        <div class="flex items-center text-red-600 text-xs font-mono tracking-wider">
          <img src="/images/wolf_icon.png" alt="" width="16" height="16" class="w-4 h-4 mr-2" onerror="this.style.display='none'" />
          js-dos - Wolfenstein 3D
        </div>
        <button id="wolf-close" type="button" aria-label="Cerrar Wolfenstein 3D" class="w-6 h-6 hover:bg-red-500 focus-visible:bg-red-500 text-red-600 hover:text-white flex items-center justify-center text-xs">✕</button>
      </div>
      <div class="w-full aspect-[16/10] bg-black relative" id="wolf-container">
        <canvas id="jsdos-wolf" class="!w-full !h-full block object-contain"></canvas>
      </div>
    </div>

