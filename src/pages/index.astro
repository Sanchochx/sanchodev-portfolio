  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const overlay = document.getElementById('crt-overlay');
      const beam = document.getElementById('crt-beam');
      if (!overlay || !beam) return;

      // Con reduced-motion se descubre el escritorio sin animación
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        overlay.style.display = 'none';
        return;
      }

      // Pequeña pausa negra inicial para crear expectación
      window.setTimeout(() => {
        beam.classList.add('animate-crt-beam');

        // Al 60% de la animación el rayo ya llena la pantalla: se quita el negro para revelar el escritorio
        window.setTimeout(() => overlay.classList.remove('bg-black'), 350);

        // Se retira del flujo para que los iconos del escritorio sean clickeables
        window.setTimeout(() => { overlay.style.display = 'none'; }, 800);
      }, 250);
    });
  </script>

  <!-- Script para actualizar el reloj en tiempo real -->
  <script>
    function updateClock(): void {
      const timeElement = document.getElementById('os-clock-time');
      const dateElement = document.getElementById('os-clock-date');
      if (timeElement && dateElement) {
        const now = new Date();
        const hours = now.getHours();
        const minutes = now.getMinutes();
        const ampm = hours >= 12 ? 'PM' : 'AM';
        const hours12 = hours % 12 || 12;
        const minutesStr = minutes < 10 ? '0' + minutes : String(minutes);

        const date = now.toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric' });

        timeElement.textContent = hours12 + ':' + minutesStr + ' ' + ampm;
        dateElement.textContent = date;
      }
    }

    setInterval(updateClock, 1000);
    updateClock();
  </script>
  <script>
    interface DosCommandInterface { exit(): Promise<void>; }
    interface DosFs { extract(url: string): Promise<void>; }
    type DosMain = (args: string[]) => Promise<DosCommandInterface>;
    interface DosBoot { ready(cb: (fs: DosFs, main: DosMain) => void): void; }
    type DosFactory = (canvas: HTMLCanvasElement, opts: { wdosboxUrl: string }) => DosBoot;

    let dosInstance: DosCommandInterface | null = null;
    let booting = false;

    // js-dos reescribe document.title al arrancar/cerrar; lo restauramos.
    const pageTitle = document.title;
    const titleEl = document.querySelector('title');
    if (titleEl) {
      new MutationObserver(() => {
        if (document.title !== pageTitle) document.title = pageTitle;
      }).observe(titleEl, { childList: true, characterData: true, subtree: true });
    }

    function openDoom(): void {
      const win = document.getElementById('doom-window');
      const canvas = document.getElementById('jsdos') as HTMLCanvasElement | null;
      const Dos = (window as unknown as { Dos?: DosFactory }).Dos;
      if (!win || !canvas) return;
      win.classList.remove('hidden');

      if (dosInstance || booting || !Dos) return;
      booting = true;
      Dos(canvas, { wdosboxUrl: 'https://js-dos.com/6.22/current/wdosbox.js' }).ready((fs, main) => {
        fs.extract('https://js-dos.com/cdn/upload/DOOM-@evilution.zip')
          .then(() => main(['-c', 'cd DOOM', '-c', 'DOOM.EXE']))
          .then((ci) => {
            // La ventana pudo cerrarse mientras cargaba
            if (win.classList.contains('hidden')) void ci.exit();
            else dosInstance = ci;
          })
          .catch((err) => console.error('DOOM failed to start', err))
          .finally(() => { booting = false; });
      });
    }

    function closeDoom(): void {
      document.getElementById('doom-window')?.classList.add('hidden');
      const container = document.getElementById('dos-container');
      if (!dosInstance || !container) return;
      void dosInstance.exit();
      dosInstance = null;
      container.innerHTML = '<canvas id="jsdos" class="!w-full !h-full block object-contain"></canvas>';
    }

    const icon = document.getElementById('doom-icon');
    icon?.addEventListener('dblclick', openDoom);
    icon?.addEventListener('keydown', (e) => { if (e.key === 'Enter') openDoom(); });
    document.getElementById('doom-close')?.addEventListener('click', closeDoom);
  </script>
  <script>
    function openPinball(): void {
      const win = document.getElementById('pinball-window');
      const container = document.getElementById('pinball-container');
      if (!win || !container) return;
      win.classList.remove('hidden');

      const existing = container.querySelector('iframe');
      if (existing) { existing.focus(); return; }
      const frame = document.createElement('iframe');
      frame.src = 'https://pinball.alula.me/';
      frame.title = '3D Pinball - Space Cadet';
      frame.className = 'w-full h-full border-none';
      frame.allow = 'autoplay; fullscreen; gamepad';
      frame.sandbox.add('allow-scripts', 'allow-same-origin', 'allow-pointer-lock');
      frame.referrerPolicy = 'no-referrer';
      // Sin foco en el iframe, las teclas de las paletas se quedan en la página padre
      frame.addEventListener('load', () => frame.focus());
      container.appendChild(frame);
      frame.focus();
    }

    function closePinball(): void {
      document.getElementById('pinball-window')?.classList.add('hidden');
      // Quitar el iframe apaga el audio y libera memoria
      document.getElementById('pinball-container')?.replaceChildren();
    }

    const pinballIcon = document.getElementById('pinball-icon');
    pinballIcon?.addEventListener('dblclick', openPinball);
    pinballIcon?.addEventListener('keydown', (e) => { if (e.key === 'Enter') openPinball(); });
    document.getElementById('pinball-close')?.addEventListener('click', closePinball);
    // Clicks on the title bar or edges would otherwise leave focus outside the game
    document.getElementById('pinball-window')?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('#pinball-close')) return;
      document.querySelector<HTMLIFrameElement>('#pinball-container iframe')?.focus();
    });
  </script>
