---
import '../styles/desktop.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import CrtOverlay from '../components/desktop/CrtOverlay.astro';
import DesktopIcon from '../components/desktop/DesktopIcon.astro';
import TerminalWindow from '../components/desktop/TerminalWindow.astro';
import Taskbar from '../components/desktop/Taskbar.astro';
import ChaosApp from '../components/desktop/apps/ChaosApp.astro';
import DoomApp from '../components/desktop/apps/DoomApp.astro';
import PinballApp from '../components/desktop/apps/PinballApp.astro';
import WolfApp from '../components/desktop/apps/WolfApp.astro';
import NotepadApp from '../components/desktop/apps/NotepadApp.astro';
import PaintApp from '../components/desktop/apps/PaintApp.astro';
import PactasisApp from '../components/desktop/apps/PactasisApp.astro';
import LetterboxdApp from '../components/desktop/apps/LetterboxdApp.astro';
import GamesApp from '../components/desktop/apps/GamesApp.astro';
import { desktopIcons } from '../data/desktopApps';

// Letterboxd/TMDB se consultan al renderizar; el caché del edge evita repetirlo en cada visita
Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');
---

<BaseLayout title="SanchoDev | Software Engineer" description="Portafolio de Santiago Sánchez Márquez">
  <script is:inline async src="https://js-dos.com/6.22/current/js-dos.js"></script>

  <main class="h-screen w-full relative z-10 flex flex-col">
    <CrtOverlay />

    <!-- Área del escritorio -->
    <div class="flex-1 relative w-full h-full p-4 flex flex-col flex-wrap content-start gap-2">
      {desktopIcons.map((entry) =>
        Array.isArray(entry) ? (
          <div class="flex flex-row items-start gap-2">
            {entry.map((icon) => <DesktopIcon {...icon} />)}
          </div>
        ) : (
          <DesktopIcon {...entry} />
        ),
      )}
    </div>

    <ChaosApp />
    <DoomApp />
    <PinballApp />
    <WolfApp />
    <NotepadApp />
    <PaintApp />
    <LetterboxdApp />
    <GamesApp />
    <PactasisApp />
    <TerminalWindow />
    <Taskbar />
  </main>

  <script>
    import '../scripts/desktop/ascii';
    import '../scripts/desktop/crt';
    import '../scripts/desktop/clock';
    import '../scripts/desktop/doom';
    import '../scripts/desktop/pinball';
    import '../scripts/desktop/wolf';
    import '../scripts/desktop/windows';
    import '../scripts/desktop/chaos';
    import '../scripts/desktop/pactasis';
    import '../scripts/desktop/paint';
  </script>
</BaseLayout>
