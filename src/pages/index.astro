---
import BaseLayout from '../layouts/BaseLayout.astro';
import LetterboxdApp from '../components/LetterboxdApp.astro';
import GamesApp from '../components/GamesApp.astro';

// Letterboxd/TMDB se consultan al renderizar; el caché del edge evita repetirlo en cada visita
Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');
---

<BaseLayout title="SanchoDev | Software Engineer" description="Portafolio de Santiago Sánchez Márquez">
  <!-- Ocultamos el Navbar global y el Footer por defecto de esta página mediante CSS -->
  <style is:global>
    header, nav, footer, #chat-widget { display: none !important; }
    body { overflow: hidden; } /* Evita el scroll en el escritorio */

    @keyframes rainbow-hue {
      from { filter: hue-rotate(0deg); }
      to { filter: hue-rotate(360deg); }
    }

    /* Texto con degradado arcoíris; el filtro rota el tono para que cambie de color */
    .rainbow-text,
    .rainbow-text * {
      color: transparent !important;
    }
    .rainbow-text {
      background-image: linear-gradient(90deg, #ff0040, #ff8000, #ffe600, #00e060, #00c8ff, #8000ff, #ff0040);
      -webkit-background-clip: text;
      background-clip: text;
    }

    @keyframes red-glow {
      from { filter: brightness(0.75); }
      to { filter: brightness(1.35); }
    }

    /* Degradado de rojos; el brillo pulsa para alternar entre tonos */
    .red-text,
    .red-text * {
      color: transparent !important;
    }
    .red-text {
      background-image: linear-gradient(90deg, #7f0000, #cc0000, #ff2a2a, #cc0000, #7f0000);
      -webkit-background-clip: text;
      background-clip: text;
    }

    /* Colores por tema de ASCII (data-theme en #terminal-window) */
    #terminal-window[data-theme="pink"] { --theme-color: #f472b6; --theme-glow: rgba(244, 114, 182, 0.6); }
    #terminal-window[data-theme="white"] { --theme-color: #f8fafc; --theme-glow: rgba(248, 250, 252, 0.6); }
    #terminal-window[data-theme="purple"] { --theme-color: #c084fc; --theme-glow: rgba(192, 132, 252, 0.6); }
    #terminal-window[data-theme="blue"] { --theme-color: #60a5fa; --theme-glow: rgba(96, 165, 250, 0.6); }
    #terminal-window[data-theme="orange"] { --theme-color: #fb923c; --theme-glow: rgba(251, 146, 60, 0.6); }

    .theme-text {
      color: var(--theme-color);
      text-shadow: 0 0 8px var(--theme-glow);
    }

    /* Marco arcoíris de la terminal (se reemplaza por el color del tema) */
    #terminal-window:not([data-theme]) { border-color: transparent; }
    #terminal-window:not([data-theme]) #terminal-titlebar { border-bottom-color: transparent; }
    #terminal-window:not([data-theme])::before,
    #terminal-window:not([data-theme]) #terminal-titlebar::after {
      content: '';
      position: absolute;
      pointer-events: none;
    }
    #terminal-window:not([data-theme])::before {
      inset: -1px;
      border: 1px solid;
      border-image: linear-gradient(90deg, #ff0040, #ff8000, #ffe600, #00e060, #00c8ff, #8000ff, #ff0040) 1;
    }
    #terminal-titlebar { position: relative; }
    #terminal-window:not([data-theme]) #terminal-titlebar::after {
      left: 0;
      right: 0;
      bottom: -1px;
      height: 1px;
      background-image: linear-gradient(90deg, #ff0040, #ff8000, #ffe600, #00e060, #00c8ff, #8000ff, #ff0040);
    }

    /* Marco y textos de la terminal con el color del tema activo */
    #terminal-window[data-theme],
    #terminal-window[data-theme] #terminal-titlebar {
      border-color: var(--theme-color);
    }
    #terminal-window[data-theme] #terminal-close {
      color: var(--theme-color);
    }
    #terminal-window[data-theme] .rainbow-text {
      animation: none;
      background-image: none;
    }
    #terminal-window[data-theme] .rainbow-text,
    #terminal-window[data-theme] .rainbow-text * {
      color: var(--theme-color) !important;
    }

    /* Rayo catódico del encendido CRT */
    @keyframes crt-beam-on {
      0% { transform: scale(0.01, 0.002); opacity: 1; }
      30% { transform: scale(1, 0.002); opacity: 1; }
      60% { transform: scale(1, 1); opacity: 1; }
      100% { transform: scale(1, 1); opacity: 0; }
    }

    .animate-crt-beam {
      animation: crt-beam-on 0.7s cubic-bezier(0.23, 1, 0.32, 1) forwards;
    }

    .perspective-container { perspective: 1000px; }

    @keyframes spin-y {
      from { transform: rotateY(0deg); }
      to { transform: rotateY(360deg); }
    }

    /* Solo se animan si el usuario no pidió reducir movimiento */
    @media (prefers-reduced-motion: no-preference) {
      .rainbow-text,
      #terminal-window:not([data-theme])::before,
      #terminal-window:not([data-theme]) #terminal-titlebar::after { animation: rainbow-hue 0.6s linear infinite; }
      .red-text { animation: red-glow 1.5s ease-in-out infinite alternate; }
      .red-text.red-text-fast { animation-duration: 0.5s; }
      .animate-spin-y { animation: spin-y 3s linear infinite; transform-style: preserve-3d; }
    }
    .log-user { color: #f87171; }
    .log-sys { color: #dc2626; text-shadow: 0 0 5px rgba(220,38,38,0.6); white-space: pre-wrap; }
  </style>

  <script is:inline async src="https://js-dos.com/6.22/current/js-dos.js"></script>

  <main class="h-screen w-full relative z-10 flex flex-col">
    <!-- Animación de Encendido CRT -->
    <div id="crt-overlay" class="fixed inset-0 z-[100] bg-black pointer-events-auto flex items-center justify-center" aria-hidden="true">
      <div id="crt-beam" class="w-full h-full bg-white opacity-0 origin-center drop-shadow-[0_0_20px_rgba(255,255,255,1)]"></div>
    </div>

    <!-- Área del escritorio -->
    <div class="flex-1 relative w-full h-full p-4 flex flex-col flex-wrap content-start gap-2">

      <!-- Fila: My Portfolio + About Me lado a lado -->
      <div class="flex flex-row items-start gap-2">

      <!-- Icono: My Portfolio (Acceso Directo) -->
      <a href="/portfolio" class="w-20 flex flex-col items-center justify-start group rounded-sm border border-transparent hover:bg-blue-500/20 hover:border-blue-400/30 transition-colors p-1 cursor-pointer z-20">
        <div class="relative w-9 h-9 mb-1">
          <!-- Icono principal -->
          <img src="/images/sanchodev_logo.png" alt="My Portfolio" class="w-full h-full object-contain drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]" />

          <!-- Flechita de acceso directo (estilo clásico) -->
          <div class="absolute -bottom-1 -left-1 w-3 h-3 bg-white border border-gray-400 flex items-center justify-center shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#0066cc" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 5l7 7-7 7" />
              <path d="M17 12H3" />
            </svg>
          </div>
        </div>

        <!-- Texto del icono -->
        <span class="text-white text-[9px] text-center font-mono tracking-wider drop-shadow-[0_1px_3px_rgba(0,0,0,1)] px-1 leading-tight mt-1">
          My Portfolio
        </span>
      </a>

      <!-- Icono: Bloc de notas -->
      <button id="notepad-icon" type="button" class="w-20 flex flex-col items-center justify-start group rounded-sm border border-transparent hover:bg-blue-500/20 hover:border-blue-400/30 focus-visible:border-blue-400/60 transition-colors p-1 cursor-pointer z-20">
        <div class="relative w-9 h-9 mb-1">
          <img src="/images/notepad_icon.png" alt="Notepad" width="36" height="36" class="w-full h-full object-contain drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]" onerror="this.onerror=null;this.src='/images/sanchodev_logo.png'" />
          <div class="absolute -bottom-1 -left-1 w-3 h-3 bg-white border border-gray-400 flex items-center justify-center shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#0066cc" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 5l7 7-7 7" />
              <path d="M17 12H3" />
            </svg>
          </div>
        </div>
        <span class="text-white text-[9px] text-center font-mono tracking-wider drop-shadow-[0_1px_3px_rgba(0,0,0,1)] px-1 leading-tight mt-1">
          About Me
        </span>
      </button>

      </div>

      <!-- P.A.C.T.A.S.I.S App -->
      <button id="pactasis-icon" type="button" class="w-20 flex flex-col items-center justify-start group rounded-sm border border-transparent hover:bg-blue-500/20 hover:border-blue-400/30 focus-visible:border-blue-400/60 transition-colors p-1 cursor-pointer z-20">
        <div class="relative w-9 h-9 mb-1">
          <img src="/images/pactasis_icon.png" alt="P.A.C.T.A.S.I.S" width="36" height="36" class="w-full h-full object-contain drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]" onerror="this.onerror=null;this.src='/images/sanchodev_logo.png'" />
          <div class="absolute -bottom-1 -left-1 w-3 h-3 bg-white border border-gray-400 flex items-center justify-center shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#0066cc" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 5l7 7-7 7" />
              <path d="M17 12H3" />
            </svg>
          </div>
        </div>
        <span class="text-white text-[9px] text-center font-mono tracking-wider drop-shadow-[0_1px_3px_rgba(0,0,0,1)] px-1 leading-tight mt-1">
          P.A.C.T.A.S.I.S
        </span>
      </button>

      <!-- Icono: MS Paint -->
      <button id="paint-icon" type="button" class="w-20 flex flex-col items-center justify-start group rounded-sm border border-transparent hover:bg-blue-500/20 hover:border-blue-400/30 focus-visible:border-blue-400/60 transition-colors p-1 cursor-pointer z-20">
        <div class="relative w-9 h-9 mb-1">
          <img src="/images/paint_icon.png" alt="MS Paint" width="36" height="36" class="w-full h-full object-contain drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]" onerror="this.onerror=null;this.src='/images/sanchodev_logo.png'" />
          <div class="absolute -bottom-1 -left-1 w-3 h-3 bg-white border border-gray-400 flex items-center justify-center shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#0066cc" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 5l7 7-7 7" />
              <path d="M17 12H3" />
            </svg>
          </div>
        </div>
        <span class="text-white text-[9px] text-center font-mono tracking-wider drop-shadow-[0_1px_3px_rgba(0,0,0,1)] px-1 leading-tight mt-1">
          MS PAINT
        </span>
      </button>

      <!-- Icono: Cine (Letterboxd/TMDB) -->
      <button id="cine-icon" type="button" class="w-20 flex flex-col items-center justify-start group rounded-sm border border-transparent hover:bg-blue-500/20 hover:border-blue-400/30 focus-visible:border-blue-400/60 transition-colors p-1 cursor-pointer z-20">
        <div class="relative w-9 h-9 mb-1">
          <img src="/images/movies_icon.png" alt="Cinema" width="36" height="36" class="w-full h-full object-contain drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]" onerror="this.onerror=null;this.src='/images/sanchodev_logo.png'" />
          <div class="absolute -bottom-1 -left-1 w-3 h-3 bg-white border border-gray-400 flex items-center justify-center shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#0066cc" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 5l7 7-7 7" />
              <path d="M17 12H3" />
            </svg>
          </div>
        </div>
        <span class="text-white text-[9px] text-center font-mono tracking-wider drop-shadow-[0_1px_3px_rgba(0,0,0,1)] px-1 leading-tight mt-1">
          Cinema
        </span>
      </button>

      <!-- Icono: Videogames -->
      <button id="games-icon" type="button" class="w-20 flex flex-col items-center justify-start group rounded-sm border border-transparent hover:bg-blue-500/20 hover:border-blue-400/30 focus-visible:border-blue-400/60 transition-colors p-1 cursor-pointer z-20">
        <div class="relative w-9 h-9 mb-1">
          <img src="/images/videogame_icon.png" alt="Videogames" width="36" height="36" class="w-full h-full object-contain drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]" onerror="this.onerror=null;this.src='/images/sanchodev_logo.png'" />
          <div class="absolute -bottom-1 -left-1 w-3 h-3 bg-white border border-gray-400 flex items-center justify-center shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#0066cc" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 5l7 7-7 7" />
              <path d="M17 12H3" />
            </svg>
          </div>
        </div>
        <span class="text-white text-[9px] text-center font-mono tracking-wider drop-shadow-[0_1px_3px_rgba(0,0,0,1)] px-1 leading-tight mt-1">
          Videogames
        </span>
      </button>

      <!-- Icono: 3D Pinball -->
      <button id="pinball-icon" type="button" class="w-20 flex flex-col items-center justify-start group rounded-sm border border-transparent hover:bg-blue-500/20 hover:border-blue-400/30 focus-visible:border-blue-400/60 transition-colors p-1 cursor-pointer z-20">
        <div class="relative w-9 h-9 mb-1">
          <img src="/images/pinball_icon.png" alt="3D Pinball" width="36" height="36" class="w-full h-full object-contain drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]" onerror="this.onerror=null;this.src='/images/sanchodev_logo.png'" />
          <div class="absolute -bottom-1 -left-1 w-3 h-3 bg-white border border-gray-400 flex items-center justify-center shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#0066cc" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 5l7 7-7 7" />
              <path d="M17 12H3" />
            </svg>
          </div>
        </div>
        <span class="text-white text-[9px] text-center font-mono tracking-wider drop-shadow-[0_1px_3px_rgba(0,0,0,1)] px-1 leading-tight mt-1">
          3D Pinball
        </span>
      </button>

      <!-- Icono: Wolfenstein 3D -->
      <button id="wolf-icon" type="button" class="w-20 flex flex-col items-center justify-start group rounded-sm border border-transparent hover:bg-blue-500/20 hover:border-blue-400/30 focus-visible:border-blue-400/60 transition-colors p-1 cursor-pointer z-20">
        <div class="relative w-9 h-9 mb-1">
          <img src="/images/wolf_icon.png" alt="Wolfenstein 3D" width="36" height="36" class="w-full h-full object-contain drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]" onerror="this.onerror=null;this.src='/images/sanchodev_logo.png'" />
          <div class="absolute -bottom-1 -left-1 w-3 h-3 bg-white border border-gray-400 flex items-center justify-center shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#0066cc" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 5l7 7-7 7" />
              <path d="M17 12H3" />
            </svg>
          </div>
        </div>
        <span class="text-white text-[9px] text-center font-mono tracking-wider drop-shadow-[0_1px_3px_rgba(0,0,0,1)] px-1 leading-tight mt-1">
          Wolfenstein 3D
        </span>
      </button>

      <!-- Icono: Chaos Faction 2 -->
      <button id="chaos-icon" type="button" class="w-20 flex flex-col items-center justify-start group rounded-sm border border-transparent hover:bg-blue-500/20 hover:border-blue-400/30 focus-visible:border-blue-400/60 transition-colors p-1 cursor-pointer z-20">
        <div class="relative w-9 h-9 mb-1">
          <img src="/images/chaos_faction_icon.png" alt="Chaos Faction 2" width="36" height="36" class="w-full h-full object-contain drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]" onerror="this.onerror=null;this.src='/images/sanchodev_logo.png'" />
          <div class="absolute -bottom-1 -left-1 w-3 h-3 bg-white border border-gray-400 flex items-center justify-center shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#0066cc" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 5l7 7-7 7" />
              <path d="M17 12H3" />
            </svg>
          </div>
        </div>
        <span class="text-white text-[9px] text-center font-mono tracking-wider drop-shadow-[0_1px_3px_rgba(0,0,0,1)] px-1 leading-tight mt-1">
          Chaos Faction 2
        </span>
      </button>

      <!-- Icono: DOOM -->
      <button id="doom-icon" type="button" class="w-20 flex flex-col items-center justify-start group rounded-sm border border-transparent hover:bg-blue-500/20 hover:border-blue-400/30 focus-visible:border-blue-400/60 transition-colors p-1 cursor-pointer z-20">
        <div class="relative w-9 h-9 mb-1">
          <img src="/images/doom_icon.png" alt="DOOM" width="36" height="36" class="w-full h-full object-contain drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]" onerror="this.onerror=null;this.src='/images/sanchodev_logo.png'" />
          <div class="absolute -bottom-1 -left-1 w-3 h-3 bg-white border border-gray-400 flex items-center justify-center shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#0066cc" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 5l7 7-7 7" />
              <path d="M17 12H3" />
            </svg>
          </div>
        </div>
        <span class="text-white text-[9px] text-center font-mono tracking-wider drop-shadow-[0_1px_3px_rgba(0,0,0,1)] px-1 leading-tight mt-1">
          DOOM
        </span>
      </button>


    </div>

    <!-- Ventana de Chaos Faction 2 (oculta por defecto) -->
    <div id="chaos-window" class="hidden fixed inset-0 m-auto h-[min(780px,calc(100vh-4rem))] w-[min(1040px,95vw)] bg-black border border-red-900 rounded-sm shadow-2xl z-50 flex flex-col">
