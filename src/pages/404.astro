---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Page Not Found">
  <main class="min-h-screen flex flex-col items-center justify-center relative z-10 text-center px-4 pt-20">
    <div class="animate-on-load">
      <h1 class="text-4xl md:text-6xl font-black text-red-600 mb-4 tracking-tighter" style="text-shadow: 0 0 20px rgba(220, 38, 38, 0.5);">
        ERROR 404
      </h1>
      <h2 class="text-lg md:text-2xl text-gray-200 mb-10 font-mono">
        &gt; PAGE_NOT_FOUND
      </h2>

      <div class="max-w-sm w-full mx-auto relative overflow-hidden rounded-xl border border-red-900/30 shadow-[0_0_30px_rgba(220,38,38,0.15)] bg-black/50">
        <img
          id="error-img"
          src="/images/404-1.png"
          alt="Sistema Caído - Error 404"
          width="512"
          height="341"
          class="w-full h-auto object-cover grayscale hover:grayscale-0 transition-all duration-500 min-h-[200px]"
        />
      </div>

      <div class="mt-12">
        <a
          href="/"
          class="inline-block px-8 py-3 bg-red-600/10 hover:bg-red-600 border border-red-600 text-red-500 hover:text-white transition-all duration-300 font-mono uppercase tracking-widest text-sm"
        >
          Take me back to index
        </a>
      </div>
    </div>
  </main>

  <script>
    const images = [
      '/images/404-1.png',
      '/images/404-2.jpg',
      '/images/404-3.jpg',
      '/images/404-4.jpg',
      '/images/404-5.png',
      '/images/404-6.jpg',
      '/images/404-7.jpeg',
    ];

    const imgElement = document.getElementById('error-img') as HTMLImageElement | null;
    if (imgElement) {
      imgElement.src = images[Math.floor(Math.random() * images.length)];
    }
  </script>
</BaseLayout>
