---
// BaseLayout — única fuente de verdad para `<html>`, `<head>` y assets globales.
// Las fuentes self-hosted (`@fontsource/*`) y la utility `.glass` viven en global.css,
// por lo que importarlo aquí cubre tipografías + Tailwind + glassmorphism en una línea.
import '../styles/global.css';
import ChatWidget from '../components/portfolio/ChatWidget.astro';
import CyberGrid from '../components/portfolio/CyberGrid.astro';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  showChat?: boolean;
}

const { title, description, ogImage, canonical, showChat = true } = Astro.props;

// `Astro.site` viene de astro.config.mjs (TODO: dominio final pendiente para US-DEPLOY-001).
// Construye URLs absolutas para canonical, og:url y og:image (los crawlers exigen absolutas).
const siteUrl = Astro.site ?? new URL('https://example.com');
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(ogImage ?? '/images/brand/sanchodev_logo.png', siteUrl).toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {/* Mismos valores que surface / on-surface de tailwind.config.mjs: pinta oscuro antes de que llegue el CSS externo. */}
    <style is:inline>
      html {
        background-color: #131313;
        color: #e5e2e1;
      }
      body {
        background-color: transparent;
      }
    </style>

    <link rel="icon" type="image/png" href="/images/brand/sanchodev_logo.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body class="text-on-surface font-sans">
    <CyberGrid />
    <slot />
    {showChat && <ChatWidget />}
    <script>
      // Shared scroll reveal (portfolio only; the desktop has no reveal elements). Replays on every entry:
      // - `.reveal-base` elements get `is-visible` + `is-entering` (styles in global.css).
      // - `[data-reveal-group]` containers only get `is-visible`; the component styles its children.
      // Each element also receives `reveal:enter` / `reveal:exit` events for JS-driven effects.
      // `data-reveal-once` opts an element out of replays: it plays on first entry and stays (until a reload).
      (() => {
        const els = document.querySelectorAll<HTMLElement>('.reveal-base, [data-reveal-group]');
        if (!els.length) return;
        // Reduced motion: CSS keeps everything visible, nothing to observe.
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        // Hysteresis: enter at 25% visible, reset only once fully out, so nothing toggles on the viewport edge.
        const ENTER_RATIO = 0.25;

        const enter = (el: HTMLElement): void => {
          if (el.classList.contains('is-visible')) return;
          if (el.classList.contains('reveal-base')) el.classList.add('is-entering');
          el.classList.add('is-visible');
          el.dispatchEvent(new CustomEvent('reveal:enter'));
          if (el.hasAttribute('data-reveal-once')) obs.unobserve(el);
        };

        // Instant reset (hidden state has no transition), so a quick re-entry always starts from scratch.
        const exit = (el: HTMLElement): void => {
          if (!el.classList.contains('is-visible')) return;
          el.classList.remove('is-visible', 'is-entering');
          el.dispatchEvent(new CustomEvent('reveal:exit'));
        };

        // Once the entrance finishes, drop the reveal transition so it doesn't override hover transitions.
        const settle = (e: TransitionEvent): void => {
          const el = e.currentTarget as HTMLElement;
          if (e.target !== el || e.propertyName !== 'transform') return;
          el.classList.remove('is-entering');
        };

        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const el = entry.target as HTMLElement;
              if (!entry.isIntersecting) exit(el);
              else if (entry.intersectionRatio >= ENTER_RATIO) enter(el);
            });
          },
          { threshold: [0, ENTER_RATIO] }
        );

        els.forEach((el) => {
          if (el.classList.contains('reveal-base')) el.addEventListener('transitionend', settle);
          obs.observe(el);
        });
      })();
    </script>
  </body>
</html>
