---
// BaseLayout — única fuente de verdad para `<html>`, `<head>` y assets globales.
// Las fuentes self-hosted (`@fontsource/*`) y la utility `.glass` viven en global.css,
// por lo que importarlo aquí cubre tipografías + Tailwind + glassmorphism en una línea.
import '../styles/global.css';
import ChatWidget from '../components/ChatWidget.astro';
import CyberGrid from '../components/CyberGrid.astro';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  showChat?: boolean;
}

const { title, description, ogImage, canonical, showChat = true } = Astro.props;

// `Astro.site` viene de astro.config.mjs (TODO: dominio final pendiente para US-DEPLOY-001).
// Construye URLs absolutas para canonical, og:url y og:image (los crawlers exigen absolutas).
const siteUrl = Astro.site ?? new URL('https://example.com');
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(ogImage ?? '/images/sanchodev_logo.png', siteUrl).toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {/* Mismos valores que surface / on-surface de tailwind.config.mjs: pinta oscuro antes de que llegue el CSS externo. */}
    <style is:inline>
      html {
        background-color: #131313;
        color: #e5e2e1;
      }
      body {
        background-color: transparent;
      }
    </style>

    <link rel="icon" type="image/png" href="/images/sanchodev_logo.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body class="text-on-surface font-sans">
    <CyberGrid />
    <slot />
    {showChat && <ChatWidget />}
    <script>
      (() => {
        const els = document.querySelectorAll('.reveal-base');
        if (!els.length) return;

        // Al terminar se quitan las clases reveal: su delay y transición pisarían el hover de los componentes.
        const cleanup = (el: Element): void => {
          const done = (e: Event): void => {
            if (e.target !== el) return;
            el.classList.remove('reveal-base', 'is-visible');
            [...el.classList]
              .filter((c) => /^delay-\d+$/.test(c))
              .forEach((c) => el.classList.remove(c));
            el.removeEventListener('transitionend', done);
          };
          el.addEventListener('transitionend', done);
        };

        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              cleanup(e.target);
              e.target.classList.add('is-visible');
              obs.unobserve(e.target);
            });
          },
          { threshold: 0.1 }
        );
        els.forEach((el) => obs.observe(el));
      })();
    </script>
  </body>
</html>
