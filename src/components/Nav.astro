---
import { Icon } from 'astro-icon/components';

const brand = '';

const links = [
  { href: '#bio', label: 'BIO' },
  { href: '#skills', label: 'SKILLS' },
  { href: '#projects', label: 'PROJECTS' },
  { href: '#contact', label: 'CONTACT' },
] as const;
---

<nav
  id="site-nav"
  aria-label="Navegación principal"
  class="glass-nav fixed top-6 left-1/2 w-[90%] max-w-container-max flex justify-between items-center px-8 py-4 z-50 shadow-[0_0_20px_rgba(0,0,0,0.5)] rounded-none"
>
  <a
    href="#hero"
    class="font-display text-2xl font-black tracking-tighter text-primary-container uppercase"
  >
    {brand}
  </a>

  <ul class="hidden md:flex gap-8 items-center list-none m-0 p-0">
    {
      links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="font-display text-sm uppercase tracking-widest font-medium text-on-surface/60 hover:text-primary-container transition-colors duration-200"
          >
            {label}
          </a>
        </li>
      ))
    }
  </ul>

  <a
    href="/Resume_SantiagoSanchezMarquez.pdf"
    download
    class="hidden md:inline-block bg-primary-container text-on-primary px-6 py-2 font-display font-bold text-sm tracking-tighter hover:opacity-90 active:scale-95 transition-all duration-150"
  >
    RESUME
  </a>

  <details class="md:hidden relative mobile-menu">
    <summary
      class="list-none cursor-pointer flex items-center justify-center w-10 h-10 text-on-surface"
      aria-label="Abrir menú de navegación"
    >
      <Icon name="material-symbols:menu" width={24} height={24} aria-hidden="true" />
    </summary>
    <ul
      class="glass absolute top-full right-0 mt-4 p-card-padding flex flex-col gap-4 min-w-[220px] list-none rounded-lg"
    >
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="font-display text-sm uppercase tracking-widest font-medium text-on-surface/60 hover:text-primary-container transition-colors duration-200"
            >
              {label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="/Resume_SantiagoSanchezMarquez.pdf"
          download
          class="block bg-primary-container text-on-primary px-4 py-2 font-display font-bold text-sm tracking-tighter text-center hover:opacity-90 active:scale-95 transition-all duration-150"
        >
          RESUME
        </a>
      </li>
    </ul>
  </details>
</nav>

<style>
  /* Ocultar el marcador por defecto de <summary> en todos los navegadores. */
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }
  .mobile-menu summary {
    list-style: none;
  }

  /* Hide-on-scroll-down — combinamos translate de centrado con el slide vertical.
     `top-6` (= 1.5rem) ya está aplicado por la utility; al ocultar empujamos
     el nav hacia arriba con translateY mientras mantenemos el centrado horizontal. */
  #site-nav {
    transform: translateX(-50%) translateY(0);
    transition: transform 280ms ease, opacity 200ms ease;
  }
  #site-nav.nav-hidden {
    transform: translateX(-50%) translateY(-150%);
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    #site-nav {
      transition: none;
    }
  }
</style>

<script>
  // Auto-hide nav on scroll down, show on scroll up. Threshold 8px para evitar
  // jitter con el bounce de algunos trackpads. Por encima de 80px nunca oculta
  // (mantiene el nav siempre visible cerca del top de la página).
  (() => {
    const nav = document.getElementById('site-nav');
    if (!nav) return;
    let lastY = window.scrollY;
    let ticking = false;

    const update = () => {
      const y = window.scrollY;
      const diff = y - lastY;
      if (y < 80) {
        nav.classList.remove('nav-hidden');
      } else if (diff > 8) {
        nav.classList.add('nav-hidden');
      } else if (diff < -8) {
        nav.classList.remove('nav-hidden');
      }
      lastY = y;
      ticking = false;
    };

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }, { passive: true });
  })();
</script>
