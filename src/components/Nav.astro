---
const links = [
  { href: '#skills', label: 'SKILLS' },
  { href: '#projects', label: 'PROJECTS' },
  { href: '#contact', label: 'CONTACT' },
  { href: '/red-lodge', label: 'RED LODGE', accent: true },
] as const;
---

<nav
  id="site-nav"
  aria-label="Navegación principal"
  class="reveal-base reveal-slow glass-nav fixed top-6 inset-x-0 mx-auto w-[94%] md:w-[90%] max-w-container-max flex justify-between items-center px-4 md:px-8 py-4 z-50 shadow-[0_0_20px_rgba(0,0,0,0.5)] rounded-none"
>
  <a href="#hero" aria-label="Volver al inicio">
    <img
      src="/images/sanchodev_logo.png"
      alt="Sancho Dev logo"
      width="40"
      height="40"
      class="h-10 w-auto"
    />
  </a>

  <ul class="flex gap-3 md:gap-8 items-center list-none m-0 p-0">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'font-display text-[11px] md:text-sm uppercase tracking-wider md:tracking-widest font-medium transition-colors duration-200',
              'accent' in link ? 'text-red-500 hover:text-red-400' : 'text-on-surface/60 hover:text-primary-container',
            ]}
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
