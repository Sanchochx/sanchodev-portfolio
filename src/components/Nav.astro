---
const links = [
  { href: '#skills', label: 'SKILLS' },
  { href: '#projects', label: 'PROJECTS' },
  { href: '#contact', label: 'CONTACT' },
] as const;
---

<nav
  id="site-nav"
  aria-label="Navegación principal"
  class="nav-intro glass-nav fixed top-6 left-1/2 w-[94%] md:w-[90%] max-w-container-max flex justify-between items-center px-4 md:px-8 py-4 z-50 shadow-[0_0_20px_rgba(0,0,0,0.5)] rounded-none"
>
  <a
    href="#hero"
    aria-label="Volver al inicio"
  >
    <img
      src="/images/sanchodev_logo.png"
      alt="Sancho Dev logo"
      width="40"
      height="40"
      class="h-10 w-auto"
    />
  </a>

  <ul class="flex gap-3 md:gap-8 items-center list-none m-0 p-0">
    {
      links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="font-display text-[11px] md:text-sm uppercase tracking-wider md:tracking-widest font-medium text-on-surface/60 hover:text-primary-container transition-colors duration-200"
          >
            {label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  /* translateX(-50%) mantiene el centrado horizontal mientras translateY oculta el nav. */
  #site-nav {
    transform: translateX(-50%) translateY(0);
    transition: transform 280ms ease, opacity 200ms ease;
  }
  #site-nav.nav-hidden {
    transform: translateX(-50%) translateY(-150%);
    opacity: 0;
    pointer-events: none;
  }
  /* Entrada Slide & Snap: misma curva que .reveal-base, a 3s como .reveal-slow, pero conservando el translateX(-50%) de centrado. */
  #site-nav.nav-intro {
    opacity: 0;
    transform: translateX(-50%) translateY(30px);
  }
  #site-nav.nav-intro.nav-in {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    transition: opacity 3s ease-out, transform 3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    #site-nav {
      transition: none;
    }
    #site-nav.nav-intro {
      transform: translateX(-50%);
    }
    #site-nav.nav-intro.nav-in {
      transition: opacity 0.3s ease-out;
    }
  }
</style>

<script>
  // Threshold 8px evita jitter por bounce de trackpads. Bajo 80px el nav nunca se oculta.
  (() => {
    const nav = document.getElementById('site-nav');
    if (!nav) return;

    // Doble rAF: garantiza un frame pintado en estado inicial para que la transición se dispare.
    // Al terminar se retiran las clases de intro y vuelve la transición normal de ocultar/mostrar.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const onIntroEnd = (e: TransitionEvent) => {
      if (e.target !== nav || e.propertyName !== (reduceMotion ? 'opacity' : 'transform')) return;
      nav.classList.remove('nav-intro', 'nav-in');
      nav.removeEventListener('transitionend', onIntroEnd);
    };
    nav.addEventListener('transitionend', onIntroEnd);
    requestAnimationFrame(() => requestAnimationFrame(() => nav.classList.add('nav-in')));

    let lastY = window.scrollY;
    let ticking = false;

    const update = () => {
      const y = window.scrollY;
      const diff = y - lastY;
      if (y < 80) {
        nav.classList.remove('nav-hidden');
      } else if (diff > 8) {
        nav.classList.add('nav-hidden');
      } else if (diff < -8) {
        nav.classList.remove('nav-hidden');
      }
      lastY = y;
      ticking = false;
    };

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }, { passive: true });
  })();
</script>
