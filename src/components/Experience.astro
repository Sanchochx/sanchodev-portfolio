---
const sectionLabel = '02 / EXPERIENCE';
const heading = 'Work Experience';

const experiences = [
  {
    role: 'Full Stack Developer Intern',
    company: 'ESE Hospital Universitario San Rafael',
    location: 'Tunja, Colombia',
    type: 'Hybrid',
    period: 'Oct 2025 – Dec 2025',
    bullets: [
      'Developed modular management systems using Angular and Node.js for administrative operations.',
      'Implemented authentication and role-based access control for secure user management.',
      'Designed responsive interfaces with Angular Material and integrated RESTful APIs.',
      'Built reporting and data visualization features to support operational decision-making.',
    ],
    tech: ['ANGULAR', 'TYPESCRIPT', 'RXJS', 'NODE.JS', 'EXPRESS', 'SQL', 'NOSQL', 'GIT'],
  },
] as const;
---

<section
  id="experience"
  aria-labelledby="experience-heading"
  class="py-section-gap"
>
  <div class="max-w-container-max mx-auto px-6">
    <header class="mb-16">
      <span class="font-display text-mono-label text-primary-container uppercase block mb-4">
        {sectionLabel}
      </span>
      <h2
        id="experience-heading"
        class="font-display text-headline-lg text-on-surface uppercase"
      >
        {heading}
      </h2>
    </header>

    <div class="relative">
      <div class="absolute left-0 top-0 bottom-0 w-px bg-gradient-to-b from-primary-container/40 via-primary-container/10 to-transparent" aria-hidden="true"></div>

      <div class="space-y-12 pl-8">
        {experiences.map((exp) => (
          <article class="relative">
            <div class="absolute -left-[2.125rem] top-1 w-3 h-3 rounded-full border-2 border-primary-container bg-surface" aria-hidden="true"></div>

            <div class="glass glass-hover rounded-lg p-card-padding">
              <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-3 mb-6">
                <div>
                  <h3 class="font-display text-headline-md text-on-surface uppercase tracking-tight mb-1">
                    {exp.role}
                  </h3>
                  <p class="font-display text-mono-label text-primary-container/80 uppercase">
                    {exp.company}
                  </p>
                </div>
                <div class="flex flex-col items-start md:items-end gap-1 shrink-0">
                  <span class="font-display text-code-snippet text-on-surface/50 tabular-nums">
                    {exp.period}
                  </span>
                  <div class="flex gap-2">
                    <span class="px-2 py-0.5 border border-white/10 font-display text-[10px] tracking-widest text-secondary/60 rounded-sm uppercase">
                      {exp.type}
                    </span>
                    <span class="px-2 py-0.5 border border-white/10 font-display text-[10px] tracking-widest text-secondary/60 rounded-sm uppercase">
                      {exp.location}
                    </span>
                  </div>
                </div>
              </div>

              <ul class="space-y-3 mb-6 list-none m-0 p-0">
                {exp.bullets.map((bullet) => (
                  <li class="flex gap-3 text-on-surface-variant text-sm leading-relaxed">
                    <span class="w-1.5 h-1.5 rounded-full bg-primary-container/60 mt-2 shrink-0" aria-hidden="true"></span>
                    {bullet}
                  </li>
                ))}
              </ul>

              <ul class="flex flex-wrap gap-2 list-none m-0 p-0">
                {exp.tech.map((tag) => (
                  <li class="px-3 py-1 border border-white/10 text-primary-container font-display text-[10px] tracking-widest rounded">
                    {tag}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
