---
const fullName = 'Santiago Sánchez Márquez';
const primaryRole = 'Software Engineer';
const secondaryRole = 'AI, DevOps & Cloud-Native';
---

<section
  id="hero"
  aria-label="Presentación de Santiago Sánchez Márquez"
  class="min-h-screen flex flex-col justify-center items-center px-5 pt-section-gap pb-section-gap relative overflow-hidden"
>
  <div class="hero-bg-glow" aria-hidden="true"></div>

  <div class="text-center max-w-container-max relative z-10">
    <h1
      id="hacker-name"
      data-value={fullName}
      aria-label={fullName}
      class="reveal-base reveal-slow font-display text-headline-xl text-primary-container drop-shadow-[0_0_10px_rgb(255_0_0/0.8)] uppercase mb-6"
    >
      {fullName}
    </h1>

    <div class="animate-on-load anim-delay-200 flex flex-col md:flex-row items-center justify-center gap-4 mb-12">
      <span
        id="hacker-sub-1"
        data-value={primaryRole}
        aria-label={primaryRole}
        class="font-sans text-body-lg text-on-surface"
      >
        {primaryRole}
      </span>
      <span class="block w-12 h-px bg-primary-container" aria-hidden="true"></span>
      <span
        id="hacker-sub-2"
        data-value={secondaryRole}
        aria-label={secondaryRole}
        class="font-sans text-body-lg text-on-surface"
      >
        {secondaryRole}
      </span>
    </div>
  </div>

  <div class="absolute bottom-10 left-1/2 -translate-x-1/2" aria-hidden="true">
    <div class="reveal-base reveal-slow delay-400 flex flex-col items-center gap-2">
      <div class="scroll-line w-px h-10 bg-gradient-to-b from-primary-container/50 to-transparent"></div>
    </div>
  </div>
</section>

<script>
  const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ!@#$%^&*()_+<>{}[]01';
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function decodeText(elementId: string, delay: number): void {
    const element = document.getElementById(elementId);
    const originalText = element?.dataset.value;
    if (!element || !originalText) return;

    setTimeout(() => {
      let iterations = 0;

      const interval = setInterval(() => {
        element.textContent = originalText
          .split('')
          .map((letter, index) =>
            index < iterations || letter === ' '
              ? letter
              : letters[Math.floor(Math.random() * letters.length)],
          )
          .join('');

        if (iterations >= originalText.length) {
          clearInterval(interval);
        }

        iterations += 1 / 3;
      }, 35);
    }, delay);
  }

  if (!prefersReducedMotion) {
    // Cascada: el nombre primero, luego cada subtítulo
    decodeText('hacker-name', 400);
    decodeText('hacker-sub-1', 1000);
    decodeText('hacker-sub-2', 1400);
  }
</script>

<style>
  .hero-bg-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 700px;
    height: 700px;
    transform: translate(-50%, -55%);
    background: radial-gradient(circle, rgb(255 0 0 / 0.07) 0%, transparent 62%);
    animation: hero-pulse 5s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes hero-pulse {
    0%, 100% { opacity: 0.6; transform: translate(-50%, -55%) scale(1); }
    50%       { opacity: 1;   transform: translate(-50%, -55%) scale(1.12); }
  }

  .scroll-line {
    animation: scroll-fade 2.2s ease-in-out infinite;
  }

  @keyframes scroll-fade {
    0%, 100% { opacity: 0.25; transform: scaleY(0.7); transform-origin: top; }
    50%       { opacity: 1;    transform: scaleY(1);   transform-origin: top; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg-glow,
    .scroll-line {
      animation: none;
    }
  }
</style>
