---
const fullName = 'Santiago Sánchez Márquez';
const primaryRole = 'Fullstack Web Developer';
const secondaryRole = 'AI Software Engineer';
---

<section
  id="hero"
  aria-label="Presentación de Santiago Sánchez Márquez"
  class="min-h-screen flex flex-col justify-center items-center px-5 pt-section-gap pb-section-gap relative overflow-hidden"
>
  <div class="hero-bg-glow" aria-hidden="true"></div>

  <div class="text-center max-w-container-max relative z-10">
    <h1 class="hero-enter hero-enter-delay-1 font-display text-headline-xl text-on-surface uppercase mb-6">
      {fullName}
    </h1>

    <div class="hero-enter hero-enter-delay-2 flex flex-col md:flex-row items-center justify-center gap-4 mb-12">
      <span class="font-sans text-body-lg text-on-surface/60">
        {primaryRole}
      </span>
      <span class="block w-12 h-px bg-primary-container" aria-hidden="true"></span>
      <span class="font-sans text-body-lg text-on-surface/60">
        {secondaryRole}
      </span>
    </div>
  </div>

  <div class="hero-enter hero-enter-delay-3 absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2" aria-hidden="true">
    <div class="scroll-line w-px h-10 bg-gradient-to-b from-primary-container/50 to-transparent"></div>
  </div>
</section>

<style>
  .hero-bg-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 700px;
    height: 700px;
    transform: translate(-50%, -55%);
    background: radial-gradient(circle, rgb(0 255 65 / 0.07) 0%, transparent 62%);
    animation: hero-pulse 5s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes hero-pulse {
    0%, 100% { opacity: 0.6; transform: translate(-50%, -55%) scale(1); }
    50%       { opacity: 1;   transform: translate(-50%, -55%) scale(1.12); }
  }

  @keyframes hero-fade-in {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .hero-enter {
    animation: hero-fade-in 0.65s ease forwards;
    opacity: 0;
  }
  .hero-enter-delay-1 { animation-delay: 150ms; }
  .hero-enter-delay-2 { animation-delay: 300ms; }
  .hero-enter-delay-3 { animation-delay: 480ms; }

  @media (prefers-reduced-motion: reduce) {
    .hero-enter {
      animation: none;
      opacity: 1;
    }
  }

  .scroll-line {
    animation: scroll-fade 2.2s ease-in-out infinite;
  }

  @keyframes scroll-fade {
    0%, 100% { opacity: 0.25; transform: scaleY(0.7); transform-origin: top; }
    50%       { opacity: 1;    transform: scaleY(1);   transform-origin: top; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg-glow,
    .scroll-line {
      animation: none;
    }
  }
</style>
