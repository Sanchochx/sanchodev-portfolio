---
const fullName = 'Santiago Sánchez Márquez';
const primaryRole = 'Fullstack Web Developer - AI Software Engineer';
const secondaryRole = 'IT Engineering Student';
const location = '';
---

<section
  id="hero"
  aria-label="Presentación de Santiago Sánchez Márquez"
  class="min-h-screen flex flex-col justify-center items-center px-5 pt-section-gap pb-section-gap"
>
  <div class="text-center max-w-container-max">
    {/* Indicador de ubicación — mono-label ya incluye tracking 0.1em desde el theme. */}
    <span class="font-display text-mono-label text-primary-container uppercase block mb-4">
      {location}
    </span>

    <h1 class="font-display text-headline-xl text-on-surface uppercase mb-6">
      {fullName}
    </h1>

    <div class="flex flex-col md:flex-row items-center justify-center gap-4">
      <span class="font-display text-headline-md text-secondary uppercase italic">
        {primaryRole}
      </span>
      {/* Separador verde — único acento neón en el subtítulo (used sparingly). */}
      <span class="hidden md:block w-12 h-px bg-primary-container" aria-hidden="true"></span>
      <span class="font-sans text-body-lg text-on-surface/60">
        {secondaryRole}
      </span>
    </div>
  </div>
</section>
