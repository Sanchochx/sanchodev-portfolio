---
// Fondo Cyber-Grid 3D estabilizado.
// Usa clonación y scaleY(-1) para el techo, evitando bugs de perspectiva en Firefox/Escritorio.
---

<div class="cyber-grid" aria-hidden="true">
  <div class="half half-top">
    <div class="plane"><div class="lines"></div></div>
  </div>
  <div class="half half-bottom">
    <div class="plane"><div class="lines"></div></div>
  </div>
</div>

<style>
  .cyber-grid {
    --cell: 60px;
    position: fixed;
    inset: 0;
    z-index: -1;
    display: flex;
    flex-direction: column;
    pointer-events: none;
    background-color: theme('colors.surface');
  }

  .half {
    position: relative;
    width: 100%;
    height: 50vh;
    perspective: 600px;
    /* El punto de fuga es el borde compartido (horizonte), como en el diseño original. */
    perspective-origin: 50% 0;
    overflow: hidden;
  }

  /* Volteamos la mitad superior. Al estar invertido, la animación "down"
     del grid se verá visualmente como si viniera hacia el usuario (hacia arriba) */
  .half-top {
    transform: scaleY(-1);
  }

  /* El plano (perspectiva + máscara) es estático; solo `.lines` se anima, vía transform. */
  .plane {
    position: absolute;
    width: 300vw;
    height: 150vh;
    left: -100vw;
    top: 0;
    overflow: hidden;
    transform-origin: top center;
    transform: rotateX(75deg) translateZ(0);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.2) 20%, #000 55%);
    mask-image: linear-gradient(to bottom, transparent 0%, rgba(0,0,0,0.2) 20%, #000 55%);
  }

  /* Una celda extra arriba para que el desplazamiento de una celda cierre el bucle sin saltos. */
  .lines {
    position: absolute;
    inset: calc(-1 * var(--cell)) 0 0 0;
    background-image:
      linear-gradient(theme('colors.primary-container / 35%') 1.5px, transparent 1.5px),
      linear-gradient(90deg, theme('colors.primary-container / 35%') 1.5px, transparent 1.5px);
    background-size: var(--cell) var(--cell);
    animation: grid-forward 2s linear infinite;
    will-change: transform;
  }

  /* Una sola animación para ambos planos */
  @keyframes grid-forward {
    from { transform: translateY(0); }
    to { transform: translateY(var(--cell)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .lines { animation: none; }
  }
</style>
