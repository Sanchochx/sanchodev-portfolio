---
const sectionLabel = 'CONTACT';
---

<section
  id="contact"
  class="pt-section-gap pb-20"
>
  <div class="max-w-container-max mx-auto px-6">
    <div class="max-w-2xl mx-auto text-center">
      <span class="reveal-base font-display text-mono-label text-on-surface uppercase block mb-4">
        {sectionLabel}
      </span>
      <span class="reveal-base delay-100 block w-12 h-px bg-primary-container mb-8 mx-auto" aria-hidden="true"></span>
    </div>

    <div class="reveal-base delay-300 mt-12 flex justify-center gap-8">
      <a
        class="group text-primary-container hover:scale-125 transition-transform duration-200"
        href="https://github.com/Sanchochx"
        rel="noopener noreferrer"
        target="_blank"
        aria-label="Abrir perfil de GitHub en una pestaña nueva"
      >
        <img src="/images/github_icon.png" alt="" width="32" height="32" loading="lazy" class="w-8 h-8" />
      </a>
      <a
        class="group text-primary-container hover:scale-125 transition-transform duration-200"
        href="https://www.linkedin.com/in/santiago-sánchez-márquez-821b742b1/"
        rel="noopener noreferrer"
        target="_blank"
        aria-label="Abrir perfil de LinkedIn en una pestaña nueva"
      >
        <img src="/images/linkedin_icon.png" alt="" width="32" height="32" loading="lazy" class="w-8 h-8" />
      </a>
    </div>
  </div>
</section>
