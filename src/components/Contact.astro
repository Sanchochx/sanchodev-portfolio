---
import { Icon } from 'astro-icon/components';

const sectionLabel = '03 / CONTACT';
const email = 'santiagosanchezmarquez@gmail.com';
---

<section
  id="contact"
  class="py-section-gap"
>
  <div class="max-w-container-max mx-auto px-6">
    <div class="max-w-2xl">
      <span data-reveal class="font-display text-mono-label text-on-surface uppercase block mb-4">
        {sectionLabel}
      </span>
      <span data-reveal data-delay="1" class="block w-12 h-px bg-primary-container mb-8" aria-hidden="true"></span>

      <div class="space-y-8 mt-12">
        <a data-reveal data-delay="2" href={`mailto:${email}`} class="block group">
          <p class="font-display text-mono-label text-secondary/40 mb-1">
            EMAIL_ADDRESS
          </p>
          <p class="font-display text-headline-md text-on-surface group-hover:text-primary-container transition-colors break-all">
            {email}
          </p>
        </a>

        <ul data-reveal data-delay="3" class="flex gap-8 list-none m-0 p-0">
          <li>
            <a
              href={"https://github.com/Sanchochx"}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 group"
              aria-label="Abrir perfil de GitHub en una pestaña nueva"
            >
              <Icon
                name="material-symbols:terminal"
                width={20}
                height={20}
                class="text-primary-container group-hover:scale-125 transition-transform"
                aria-hidden="true"
              />
              <span class="font-display text-mono-label text-secondary group-hover:text-on-surface transition-colors">
                GITHUB
              </span>
            </a>
          </li>
          <li>
            <a
              href={"https://www.linkedin.com/in/santiago-sánchez-márquez-821b742b1/"}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 group"
              aria-label="Abrir perfil de LinkedIn en una pestaña nueva"
            >
              <Icon
                name="material-symbols:link"
                width={20}
                height={20}
                class="text-primary-container group-hover:scale-125 transition-transform"
                aria-hidden="true"
              />
              <span class="font-display text-mono-label text-secondary group-hover:text-on-surface transition-colors">
                LINKEDIN
              </span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
