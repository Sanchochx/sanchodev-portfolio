---
interface LocalGame {
  id: string;
}

// El `id` debe coincidir EXACTAMENTE con el nombre de las imágenes (sin extensión):
//  - portada completa:  public/images/videogame_covers/<id>.jpg (.png o .webp)
//  - lomo (repisa):     public/images/videogame_covers/<id>-spine.png (.jpg o .webp)
const localGames: LocalGame[] = [
  { id: 'the-last-of-us-part-2' },
  { id: 'metal-gear-solid-2-sons-of-liberty' },
  { id: 'yakuza-0' },
  { id: 'half-life' },
  { id: 'the-elder-scrolls-v-skyrim' },
  { id: 'gears-of-war-3' },
  { id: 'doom-eternal' },
  { id: 'silent-hill-2' },
  { id: 'wolfenstein-2-the-new-colossus' },
  { id: 'manhunt' },
  { id: 'the-last-of-us' },
  { id: 'resident-evil-7-biohazard' },
  { id: 'portal-2' },
  { id: 'super-mario-64-1996' },
  { id: 'team-fortress-2' },
  { id: 'yakuza-kiwami' },
  { id: 'wolfenstein-the-new-order' },
  { id: 'gears-of-war' },
  { id: 'gears-of-war-2' },
  { id: 'left-4-dead-2' },
  { id: 'max-payne' },
  { id: 'max-payne-2-the-fall-of-max-payne' },
  { id: 'mario-kart-ds' },
  { id: 'fallout-4' },
  { id: 'fallout-new-vegas' },
  { id: 'doom-2' },
  { id: 'half-life-2' },
  { id: 'new-super-mario-bros' },
  { id: 'world-of-warcraft-wrath-of-the-lich-king' },
  { id: 'wolfenstein-3d' },
  { id: 'grand-theft-auto-san-andreas' },
  { id: 'jojos-bizarre-adventure-all-star-battle-r' },
  { id: 'slender-the-arrival' },
];

// Reparte los juegos en dos filas, una debajo de la otra
const ROW_COUNT = 2;
const perRow = Math.ceil(localGames.length / ROW_COUNT);
const rows: LocalGame[][] = Array.from({ length: ROW_COUNT }, (_, i) => localGames.slice(i * perRow, (i + 1) * perRow));

// Nombre legible a partir del id, solo para accesibilidad (aria-label / alt)
const readableName = (id: string): string => id.replace(/-/g, ' ');

// Tonos distintos para que los lomos parezcan cajas diferentes
const spineColors: string[] = ['bg-[#2a2a2a]', 'bg-[#333333]', 'bg-[#222222]', 'bg-[#1f1f1f]', 'bg-[#2b1a1a]'];
---

<!-- Ventana de Videogames (oculta por defecto) -->
<div id="games-window" class="hidden fixed inset-0 m-auto h-[min(540px,calc(100vh-4rem))] w-[min(520px,95vw)] bg-black border border-red-900 rounded-sm shadow-2xl z-40 flex flex-col font-mono overflow-hidden">
  <div id="games-titlebar" class="h-8 shrink-0 bg-black flex items-center justify-between px-2 select-none border-b border-red-900 cursor-move touch-none">
    <div class="flex items-center text-red-600 text-xs font-mono tracking-wider">
      <img src="/images/videogame_icon.png" alt="" width="16" height="16" class="w-4 h-4 mr-2" onerror="this.style.display='none'" />
      Videogames
    </div>
    <button id="games-close" type="button" aria-label="Close Videogames" class="w-6 h-6 hover:bg-red-500 focus-visible:bg-red-500 text-red-600 hover:text-white flex items-center justify-center text-xs">✕</button>
  </div>

  <div class="flex-1 relative overflow-hidden bg-black text-gray-300 selection:bg-green-800 selection:text-white">
    <!-- Vista 1: la repisa -->
    <div id="shelf-view" class="custom-scrollbar w-full h-full px-6 pt-6 pb-8 overflow-y-auto transition-opacity duration-300">
      <h2 class="text-base font-bold border-b border-red-900 pb-2 mb-2 font-mono rainbow-text text-center whitespace-nowrap">My videogame library</h2>

      <!-- Cada fila de lomos va centrada y apoyada sobre su propio estante -->
      <div class="flex flex-col gap-10 pt-6">
        {rows.map((row, rowIndex) => (
          <div>
            <div class="flex flex-wrap justify-center content-start gap-x-1 px-2">
              {row.map((game, i) => (
                <button
                  type="button"
                  data-game-id={game.id}
                  data-game-label={readableName(game.id)}
                  aria-label={readableName(game.id)}
                  class={`game-spine relative w-12 h-40 ${spineColors[(rowIndex * perRow + i) % spineColors.length]} border-x border-t border-white/10 cursor-pointer hover:-translate-y-4 focus-visible:-translate-y-4 hover:bg-red-950 focus-visible:bg-red-950 motion-reduce:hover:translate-y-0 motion-reduce:focus-visible:translate-y-0 transition-transform duration-200 flex items-center justify-center`}
                >
                  <img src={`/images/videogame_covers/${game.id}-spine.png`} alt="" loading="lazy" class="spine-art absolute inset-0 w-full h-full object-fill opacity-0 pointer-events-none" />
                </button>
              ))}
            </div>
            <!-- Estante: tabla con borde superior y sombra debajo -->
            <div class="h-2 bg-gradient-to-b from-red-950 to-black border-t border-red-900/60 shadow-[0_10px_10px_rgba(0,0,0,0.8)]" aria-hidden="true"></div>
          </div>
        ))}
      </div>
    </div>

    <!-- Vista 2: showcase 3D (oculta por defecto) -->
    <div id="showcase-view" class="absolute inset-0 hidden flex-col items-center justify-center bg-black/90 z-20">
      <button id="games-back" type="button" class="absolute top-4 left-4 text-red-600 font-mono text-xs hover:text-white hover:bg-red-500 focus-visible:text-white focus-visible:bg-red-500 px-3 py-1 border border-red-900 transition-colors z-30">
        Back to library
      </button>

      <div class="showcase-stage relative h-[calc(100%-4.5rem)] max-h-[26rem] aspect-[7/9] mt-8">
        <div id="game-3d-box" class="w-full h-full">
          <!-- La imagen es la carátula desplegada (contra + lomo + frente): object-right muestra el frente y object-left la parte de atrás -->
          <button id="game-flip" type="button" aria-label="Flip the box to see the other side" class="game-flip block relative w-full h-full cursor-pointer">
            <div class="flip-face absolute inset-0 border border-red-600/60 rounded-sm overflow-hidden bg-black">
              <img id="showcase-cover" src="" alt="" width="280" height="360" class="w-full h-full object-cover object-right" />
            </div>
            <div class="flip-face flip-back absolute inset-0 border border-red-600/60 rounded-sm overflow-hidden bg-black">
              <img id="showcase-back" src="" alt="" width="280" height="360" class="w-full h-full object-cover object-left" />
            </div>
          </button>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  /* Con arte de lomo, el fondo gris y el borde sobran */
  .game-spine.has-art {
    background: none;
    border-color: transparent;
  }

  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: #0a0a0a;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #7f1d1d;
    border-radius: 4px;
  }

  .showcase-stage {
    perspective: 1200px;
  }

  #game-3d-box {
    transform-style: preserve-3d;
  }

  /* Giro de la caja al hacer clic: frente (0°) <-> parte de atrás (180°) */
  .game-flip {
    transform-style: preserve-3d;
    transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .game-flip.is-flipped {
    transform: rotateY(180deg);
  }

  .flip-face {
    backface-visibility: hidden;
  }

  .flip-back {
    transform: rotateY(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .game-flip {
      transition: none;
    }
  }

  /* La carátula entra girando sobre su eje Y y va frenando hasta quedar quieta de frente */
  @keyframes spin-in {
    0% {
      transform: rotateY(-1080deg) scale(0.4);
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    100% {
      transform: rotateY(0deg) scale(1);
      opacity: 1;
    }
  }

  .animate-spin-in {
    animation: spin-in 1.4s cubic-bezier(0.1, 0.7, 0.2, 1) forwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-spin-in {
      animation: none;
    }
  }
</style>

<script>
  const gamesWindow = document.getElementById('games-window');
  const shelfView = document.getElementById('shelf-view');
  const showcaseView = document.getElementById('showcase-view');
  const box = document.getElementById('game-3d-box');
  const cover = document.getElementById('showcase-cover') as HTMLImageElement | null;
  const backCover = document.getElementById('showcase-back') as HTMLImageElement | null;
  const flip = document.getElementById('game-flip');

  const COVER_EXTENSIONS = ['jpg', 'png', 'webp'];
  const SPINE_EXTENSIONS = ['png', 'jpg', 'webp'];
  const COVER_DIR = '/images/videogame_covers';
  const FALLBACK_COVER = '/images/sanchodev_logo.png';
  let fadeTimer: number | undefined;

  // Prueba .jpg, luego .png y .webp; si no existe ninguna, usa el logo
  const loadCover = (id: string): void => {
    if (!cover) return;
    let attempt = 0;
    cover.onerror = () => {
      attempt += 1;
      if (attempt < COVER_EXTENSIONS.length) {
        cover.src = `${COVER_DIR}/${id}.${COVER_EXTENSIONS[attempt]}`;
      } else {
        cover.onerror = null;
        cover.src = FALLBACK_COVER;
      }
    };
    // La parte de atrás reutiliza la misma imagen, ya resuelta la extensión
    cover.onload = () => {
      if (backCover) backCover.src = cover.src;
    };
    cover.src = `${COVER_DIR}/${id}.${COVER_EXTENSIONS[0]}`;
  };

  // Cuando carga la imagen del lomo, sustituye al texto y ajusta el ancho a su proporción
  const applySpineArt = (spine: HTMLButtonElement, art: HTMLImageElement): void => {
    if (!art.naturalWidth || !art.naturalHeight) return;
    spine.style.width = `${Math.max(14, Math.round((spine.offsetHeight * art.naturalWidth) / art.naturalHeight))}px`;
    spine.classList.add('has-art');
    art.style.opacity = '1';
  };

  document.querySelectorAll<HTMLButtonElement>('.game-spine').forEach((spine) => {
    const art = spine.querySelector<HTMLImageElement>('.spine-art');
    if (!art) return;
    // Prueba -spine.png, luego .jpg y .webp; si no hay ninguno, el lomo queda vacío
    let attempt = 0;
    art.addEventListener('error', () => {
      attempt += 1;
      if (attempt < SPINE_EXTENSIONS.length) {
        art.src = `${COVER_DIR}/${spine.dataset.gameId}-spine.${SPINE_EXTENSIONS[attempt]}`;
      }
    });
    if (art.complete) applySpineArt(spine, art);
    art.addEventListener('load', () => applySpineArt(spine, art));
  });

  flip?.addEventListener('click', () => flip.classList.toggle('is-flipped'));

  const showShelf = (): void => {
    window.clearTimeout(fadeTimer);
    flip?.classList.remove('is-flipped');
    showcaseView?.classList.add('hidden');
    showcaseView?.classList.remove('flex');
    shelfView?.classList.remove('hidden');
    // Pequeño retardo para que el fade-in se vea fluido
    window.setTimeout(() => {
      if (shelfView) shelfView.style.opacity = '1';
    }, 50);
  };

  const revealGame = (id: string, label: string): void => {
    flip?.classList.remove('is-flipped');
    loadCover(id);
    if (cover) cover.alt = label;
    if (backCover) backCover.alt = `${label} (back)`;
    // textContent: nunca innerHTML con datos que se inyectan dinámicamente

    if (shelfView) shelfView.style.opacity = '0';
    fadeTimer = window.setTimeout(() => {
      shelfView?.classList.add('hidden');
      showcaseView?.classList.remove('hidden');
      showcaseView?.classList.add('flex');

      // Reinicia la animación 3D
      box?.classList.remove('animate-spin-in');
      void box?.offsetWidth;
      box?.classList.add('animate-spin-in');

      document.getElementById('games-back')?.focus();
    }, 300);
  };

  document.querySelectorAll<HTMLButtonElement>('.game-spine').forEach((spine) => {
    spine.addEventListener('click', () => {
      const { gameId = '', gameLabel = '' } = spine.dataset;
      revealGame(gameId, gameLabel);
    });
  });

  document.getElementById('games-back')?.addEventListener('click', showShelf);
  // Al cerrar la ventana se vuelve a la repisa
  document.getElementById('games-close')?.addEventListener('click', showShelf);
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !gamesWindow?.classList.contains('hidden') && !showcaseView?.classList.contains('hidden')) {
      showShelf();
    }
  });
</script>
