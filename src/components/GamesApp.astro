---
interface RawgGame {
  name: string;
  released: string | null;
  background_image: string | null;
  detail?: string;
}

// Slugs o IDs de RAWG; añade tantos como quieras
const favoriteGamesList: string[] = [
  'the-last-of-us-part-2',
  'metal-gear-solid-2-sons-of-liberty',
  'yakuza-0',
  'half-life',
  'the-elder-scrolls-v-skyrim',
  'gears-of-war-3',
  'doom-eternal',
  'silent-hill-2',
  'wolfenstein-2-the-new-colossus',
  'manhunt',
  'outlast',
  'the-last-of-us',
  'world-of-warcraft-cataclysm',
  'resident-evil-7-biohazard',
  'dota-2',
  'portal-2',
  'super-mario-64-1996',
  'team-fortress-2',
  'project-zomboid',
  'outlast-2',
  'yakuza-kiwami',
  'wolfenstein-the-new-order',
  'gears-of-war',
  'gears-of-war-2',
  'left-4-dead-2',
  'max-payne',
  'max-payne-2-the-fall-of-max-payne',
  'mario-kart-ds',
  'fallout-4',
  'doom-2',
  'doom-ii',
  'half-life-2',
  'new-super-mario-bros',
  'world-of-warcraft-wrath-of-the-lich-king',
  'wolfenstein-3d',
  'grand-theft-auto-san-andreas',
  'jojos-bizarre-adventure-all-star-battle-r',
  'slender-the-arrival',
  'counter-strike',
];

const rawgApiKey: string | undefined = import.meta.env.RAWG_API_KEY;

let favoriteGames: RawgGame[] = [];

if (rawgApiKey) {
  try {
    const responses = await Promise.all(
      favoriteGamesList.map(async (gameId): Promise<RawgGame | null> => {
        const res = await fetch(`https://api.rawg.io/api/games/${gameId}?key=${rawgApiKey}`);
        return res.ok ? ((await res.json()) as RawgGame) : null;
      })
    );
    favoriteGames = responses.filter((g): g is RawgGame => g !== null && !g.detail);
  } catch (e) {
    console.error('Error fetching RAWG API:', e);
  }
}
---

<!-- Ventana de Juegos (oculta por defecto) -->
<div id="games-window" class="hidden fixed inset-0 m-auto h-[min(500px,calc(100vh-4rem))] w-[min(700px,95vw)] bg-black border border-red-900 rounded-sm shadow-2xl z-40 flex flex-col font-mono overflow-hidden">
  <div id="games-titlebar" class="h-8 shrink-0 bg-black flex items-center justify-between px-2 select-none border-b border-red-900 cursor-move touch-none">
    <div class="flex items-center text-red-600 text-xs font-mono tracking-wider">
      <img src="/images/videogame_icon.png" alt="" width="16" height="16" class="w-4 h-4 mr-2" onerror="this.style.display='none'" />
      Videogames
    </div>
    <button id="games-close" type="button" aria-label="Close Videogames" class="w-6 h-6 hover:bg-red-500 focus-visible:bg-red-500 text-red-600 hover:text-white flex items-center justify-center text-xs">✕</button>
  </div>

  <div class="flex-1 overflow-y-auto p-6 bg-black text-gray-300 selection:bg-green-800 selection:text-white">
    <section aria-labelledby="games-favorites-title">
      <h2 id="games-favorites-title" class="text-base font-bold border-b border-red-900 pb-2 mb-4 font-mono rainbow-text">FAVS</h2>
      {favoriteGames.length > 0 ? (
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          {favoriteGames.map((game) => (
            <div class="flex flex-col items-center group">
              {game.background_image ? (
                <img src={game.background_image} alt={game.name} width="200" height="300" loading="lazy" class="w-full h-auto aspect-[2/3] object-cover rounded-sm shadow-lg border border-red-900/50 group-hover:border-red-600 transition-colors" />
              ) : (
                <div class="w-full aspect-[2/3] bg-black flex items-center justify-center border border-red-900/50 text-xs text-center p-2">{game.name}</div>
              )}
              <span class="text-xs text-center mt-2 font-semibold truncate w-full text-gray-300">{game.name}</span>
              <span class="text-[10px] text-yellow-500">{game.released ? game.released.split('-')[0] : 'TBA'}</span>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-xs text-red-400 font-mono">Error: RAWG_API_KEY missing or invalid.</p>
      )}
    </section>
  </div>
</div>
