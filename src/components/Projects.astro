---
import { Icon } from 'astro-icon/components';
import { projects } from '../data/projects';

const sectionLabel = '02 / MY PROJECTS';
---

<section
  id="projects"
  class="py-section-gap"
>
  <div class="max-w-container-max mx-auto px-6">
    <header class="mb-16">
      <span data-reveal class="font-display text-mono-label text-on-surface uppercase block mb-4">
        {sectionLabel}
      </span>
      <span data-reveal data-delay="1" class="block w-12 h-px bg-primary-container mb-6" aria-hidden="true"></span>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter">
      {
        projects.map((project, i) => (
          <article
            data-reveal
            data-delay={String((i % 3) + 1)}
            class="glass glass-hover rounded-lg p-card-padding flex flex-col group"
          >
            <div class="relative w-full aspect-video mb-6 overflow-hidden bg-surface-container rounded">
              {project.image ? (
                <>
                  <img
                    src={project.image}
                    alt={project.imageAlt}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
                  />
                  <div class="project-image-overlay" aria-hidden="true" />
                </>
              ) : (
                <div
                  class="w-full h-full project-placeholder"
                  role="img"
                  aria-label={project.imageAlt}
                />
              )}
            </div>

            <h3 class="font-display text-headline-md text-on-surface mb-2 uppercase tracking-tight">
              {project.title.replaceAll('_', ' ')}
            </h3>
            <p class="font-sans text-body-md text-on-surface-variant mb-6 leading-relaxed">
              {project.description}
            </p>

            <div class="space-y-4 mb-8">
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <span class="w-1.5 h-1.5 bg-primary-container rounded-full" />
                  <span class="font-display text-mono-label text-xs text-on-surface/40 uppercase">
                    Problem
                  </span>
                </div>
                <p class="text-sm text-on-surface-variant pl-4 border-l border-white/5">
                  {project.problem}
                </p>
              </div>
              <div>
                <div class="flex items-center gap-2 mb-1">
                  <span class="w-1.5 h-1.5 bg-primary-container rounded-full" />
                  <span class="font-display text-mono-label text-xs text-on-surface/40 uppercase">
                    Tech Decision
                  </span>
                </div>
                <p class="text-sm text-on-surface-variant pl-4 border-l border-white/5">
                  {project.techDecision}
                </p>
              </div>
            </div>

            <ul class="flex flex-wrap gap-2 mb-8 list-none m-0 p-0">
              {project.tech.map((tag) => (
                <li class="px-3 py-1 border border-white/10 text-primary-container font-display text-[10px] tracking-widest rounded">
                  {tag}
                </li>
              ))}
            </ul>

            <div class="mt-auto flex flex-wrap gap-4">
              <a
                href={project.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 font-display text-mono-label text-xs text-on-surface hover:text-primary-container transition-colors"
              >
                <span>[ VIEW_SOURCE ]</span>
                <Icon
                  name="material-symbols:terminal"
                  width={16}
                  height={16}
                  class="transition-transform duration-200 group-hover:translate-x-1"
                  aria-hidden="true"
                />
              </a>
              {project.websiteHref && (
                <a
                  href={project.websiteHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 font-display text-mono-label text-xs text-on-surface hover:text-primary-container transition-colors"
                >
                  <span>[ VIEW_WEBSITE ]</span>
                  <Icon
                    name="material-symbols:open-in-new"
                    width={16}
                    height={16}
                    class="transition-transform duration-200 group-hover:translate-x-1"
                    aria-hidden="true"
                  />
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Multiply con tinte verde apaga los blancos de las screenshots y unifica la paleta. */
  .project-image-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(
        to top,
        rgb(10 10 10 / 0.55) 0%,
        rgb(10 10 10 / 0.15) 40%,
        transparent 70%
      ),
      rgb(0 255 65 / 0.18);
    mix-blend-mode: multiply;
    transition: opacity 500ms ease;
  }

  .group:hover .project-image-overlay {
    opacity: 0.7;
  }

  .project-placeholder {
    background-color: theme('colors.surface-container');
    background-image:
      radial-gradient(
        circle at 30% 20%,
        rgb(0 255 65 / 0.18),
        transparent 55%
      ),
      radial-gradient(
        circle at 80% 80%,
        rgb(0 255 65 / 0.08),
        transparent 50%
      ),
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px);
    background-size: 100% 100%, 100% 100%, 24px 24px, 24px 24px;
  }

  @media (prefers-reduced-motion: reduce) {
    .group:hover img,
    .group:hover .material-symbols-outlined {
      transform: none !important;
    }
  }
</style>
