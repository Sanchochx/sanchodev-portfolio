---
import Parser from 'rss-parser';

interface FavoriteMovie {
  title: string;
  poster_path: string | null;
}

interface RecentMovie {
  title: string;
  rating: string;
  link: string;
  poster: string;
}

const FETCH_TIMEOUT_MS = 4000;
const favoriteIds: number[] = [103, 1018, 28422, 27064];
const tmdbApiKey: string | undefined = import.meta.env.TMDB_API_KEY;

let favorites: FavoriteMovie[] = [];

if (tmdbApiKey) {
  try {
    const responses = await Promise.all(
      favoriteIds.map(async (id): Promise<FavoriteMovie | null> => {
        const res = await fetch(`https://api.themoviedb.org/3/movie/${id}?api_key=${tmdbApiKey}&language=en-US`, {
          signal: AbortSignal.timeout(FETCH_TIMEOUT_MS),
        });
        return res.ok ? ((await res.json()) as FavoriteMovie) : null;
      })
    );
    favorites = responses.filter((m): m is FavoriteMovie => m !== null && Boolean(m.poster_path));
  } catch (e) {
    // Solo el mensaje: el error completo puede incluir la URL con api_key en los logs
    console.error('Error fetching TMDB:', e instanceof Error ? e.name : 'unknown');
  }
}

let recentMovies: RecentMovie[] = [];

try {
  const parser = new Parser({
    timeout: FETCH_TIMEOUT_MS,
    customFields: {
      item: ['letterboxd:filmTitle', 'letterboxd:filmYear', 'letterboxd:memberRating'],
    },
  });
  const feed = await parser.parseURL('https://letterboxd.com/Sanchochx/rss/');
  recentMovies = feed.items.filter((item) => item['letterboxd:filmTitle']).slice(0, 10).map((item): RecentMovie => {
    const imgMatch = item.content?.match(/src="([^"]+)"/);
    return {
      title: (item['letterboxd:filmTitle'] as string | undefined) ?? item.title ?? '',
      rating: (item['letterboxd:memberRating'] as string | undefined) ?? '',
      link: item.link ?? 'https://letterboxd.com/Sanchochx/',
      poster: imgMatch ? imgMatch[1] : '',
    };
  });
} catch (e) {
  console.error('Error fetching Letterboxd RSS:', e);
}
---

<!-- Ventana de Cine (oculta por defecto) -->
<div id="cine-window" class="hidden fixed inset-0 m-auto h-[min(560px,calc(100vh-4rem))] w-[min(700px,95vw)] bg-black border border-red-900 rounded-sm shadow-2xl z-40 flex flex-col font-mono overflow-hidden">
  <div id="cine-titlebar" class="h-8 shrink-0 bg-black flex items-center justify-between px-2 select-none border-b border-red-900 cursor-move touch-none">
    <div class="flex items-center text-red-600 text-xs font-mono tracking-wider">
      <img src="/images/movies_icon.png" alt="" width="16" height="16" class="w-4 h-4 mr-2" onerror="this.style.display='none'" />
      Cinema
    </div>
    <button id="cine-close" type="button" aria-label="Close Cinema" class="w-6 h-6 hover:bg-red-500 focus-visible:bg-red-500 text-red-600 hover:text-white flex items-center justify-center text-xs">✕</button>
  </div>

  <div class="flex-1 overflow-y-auto p-6 bg-black text-gray-300 selection:bg-green-800 selection:text-white">
    <section class="mb-8" aria-labelledby="cine-favorites-title">
      <h2 id="cine-favorites-title" class="text-base font-bold border-b border-red-900 pb-2 mb-4 font-mono rainbow-text">FAVS</h2>
      {favorites.length > 0 ? (
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          {favorites.map((movie) => (
            <div class="flex flex-col items-center group">
              <img
                src={`https://image.tmdb.org/t/p/w200${movie.poster_path}`}
                alt={movie.title}
                width="200"
                height="300"
                loading="lazy"
                class="w-full h-auto aspect-[2/3] rounded-sm shadow-lg border border-red-900/50 group-hover:border-red-600 transition-colors"
              />
              <span class="text-xs text-center mt-2 font-semibold truncate w-full text-gray-300">{movie.title}</span>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-xs text-red-400 font-mono">Error: TMDB_API_KEY missing or invalid.</p>
      )}
    </section>

    <section aria-labelledby="cine-recent-title">
      <h2 id="cine-recent-title" class="text-base font-bold border-b border-red-900 pb-2 mb-4 font-mono rainbow-text">RECENTLY WATCHED</h2>
      {recentMovies.length > 0 ? (
        <div class="flex items-center gap-2">
          <button id="cine-prev" type="button" aria-label="Previous movies" class="shrink-0 w-7 h-7 border border-red-900 text-red-600 hover:bg-red-500 hover:text-white focus-visible:bg-red-500 focus-visible:text-white flex items-center justify-center text-xs transition-colors">◀</button>
          <div id="cine-carousel" class="flex-1 min-w-0 flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth motion-reduce:scroll-auto pb-2">
            {recentMovies.map((movie) => (
              <a href={movie.link} target="_blank" rel="noopener noreferrer" class="snap-start shrink-0 w-[calc((100%-3rem)/4)] min-w-[110px] flex flex-col items-center group hover:opacity-80 focus-visible:opacity-80 transition-opacity">
                {movie.poster ? (
                  <img src={movie.poster} alt={movie.title} width="200" height="300" loading="lazy" class="w-full h-auto aspect-[2/3] rounded-sm shadow-lg border border-red-900/50" />
                ) : (
                  <div class="w-full aspect-[2/3] bg-black flex items-center justify-center border border-red-900/50 text-xs text-center p-2">{movie.title}</div>
                )}
                <span class="text-xs text-center mt-2 font-semibold truncate w-full text-gray-300">{movie.title}</span>
                <span class="text-[10px] text-yellow-500">{movie.rating ? `Rating: ${movie.rating} / 5` : 'Unrated'}</span>
              </a>
            ))}
          </div>
          <button id="cine-next" type="button" aria-label="Next movies" class="shrink-0 w-7 h-7 border border-red-900 text-red-600 hover:bg-red-500 hover:text-white focus-visible:bg-red-500 focus-visible:text-white flex items-center justify-center text-xs transition-colors">▶</button>
        </div>
      ) : (
        <p class="text-xs text-red-400 font-mono">Error: Letterboxd feed unavailable.</p>
      )}
    </section>
  </div>
</div>

<script>
  const carousel = document.getElementById('cine-carousel');
  const scrollCarousel = (dir: 1 | -1): void => {
    if (!carousel) return;
    // Avanza una "página" (4 pósters); al llegar al extremo da la vuelta como una ruleta
    const atEnd = carousel.scrollLeft + carousel.clientWidth >= carousel.scrollWidth - 2;
    if (dir === 1 && atEnd) carousel.scrollTo({ left: 0 });
    else if (dir === -1 && carousel.scrollLeft <= 2) carousel.scrollTo({ left: carousel.scrollWidth });
    else carousel.scrollBy({ left: dir * carousel.clientWidth });
  };
  document.getElementById('cine-prev')?.addEventListener('click', () => scrollCarousel(-1));
  document.getElementById('cine-next')?.addEventListener('click', () => scrollCarousel(1));
</script>
