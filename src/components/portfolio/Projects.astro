---
import { Icon } from 'astro-icon/components';
import { projects } from '../../data/projects';

const sectionLabel = 'PROJECTS';

const revealDelays = ['delay-100', 'delay-200', 'delay-300', 'delay-400'] as const;

const actionClass = 'project-action inline-flex items-center gap-2 font-sans text-xs';
---

<section
  id="projects"
  class="py-section-gap"
>
  <div class="max-w-container-max mx-auto px-6">
    <header class="mb-16">
      <span class="reveal-base font-display text-mono-label text-on-surface uppercase block mb-4">
        {sectionLabel}
      </span>
      <span class="reveal-base delay-100 block w-12 h-px bg-primary-container mb-6" aria-hidden="true"></span>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-gutter">
      {
        projects.map((project, i) => (
          <article
            class:list={['reveal-base', revealDelays[i % 4], 'project-card card-surface rounded-lg p-4 flex flex-col group relative']}
          >
            <div class="card-well w-full aspect-video mb-3 overflow-hidden rounded">
              {project.image ? (
                <>
                  <img
                    src={project.image}
                    alt={project.imageAlt}
                    width="640"
                    height="360"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity duration-200 ease-out"
                  />
                  <div class="project-image-overlay" aria-hidden="true" />
                </>
              ) : (
                <div
                  class="w-full h-full project-placeholder"
                  role="img"
                  aria-label={project.imageAlt}
                />
              )}
            </div>

            <h3 class="card-title card-title-clamp mb-2">
              {project.title.replaceAll('_', ' ')}
            </h3>
            <p class="card-summary mb-4">{project.summary}</p>

            <div class="project-card-footer mt-auto pt-3">
              <button
                type="button"
                class="project-card-trigger inline-flex items-center gap-2 font-sans text-xs"
                data-project-index={i}
                aria-haspopup="dialog"
                aria-label={`View details: ${project.title.replaceAll('_', ' ')}`}
              >
                <span class="project-label"><span class="project-bracket">[</span> View Details <span class="project-bracket">]</span></span>
                <Icon name="material-symbols:terminal" width={16} height={16} aria-hidden="true" />
              </button>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  {/* One shared modal, filled from projects.ts by the script below. */}
  <dialog
    id="project-modal"
    class="project-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="project-modal-title"
  >
    <div class="project-modal-panel rounded-sm flex flex-col">
      <div class="project-modal-bar h-8 shrink-0 flex items-center justify-end px-1">
        <button
          type="button"
          id="project-modal-close"
          aria-label="Close project details"
          class="project-modal-close w-6 h-6 shrink-0 flex items-center justify-center text-xs"
        >
          ✕
        </button>
      </div>

      <div class="overflow-y-auto p-5 md:p-6">
        <div class="card-well w-full aspect-video mb-6 overflow-hidden rounded">
          <img
            id="project-modal-image"
            alt=""
            width="640"
            height="360"
            decoding="async"
            class="w-full h-full object-cover"
          />
          <div id="project-modal-placeholder" class="w-full h-full project-placeholder" role="img" hidden></div>
        </div>

        <h2 id="project-modal-title" class="modal-title mb-2"></h2>
        <p id="project-modal-description" class="project-modal-description font-sans text-body-md mb-8 leading-relaxed"></p>

        <ul id="project-modal-tags" class="flex flex-wrap gap-2 mb-8 list-none m-0 p-0"></ul>

        <div class="flex flex-wrap gap-4">
          <a id="project-modal-source" href="#" target="_blank" rel="noopener noreferrer" class={actionClass}>
            <span class="project-label"><span class="project-bracket">[</span> View Source <span class="project-bracket">]</span></span>
            <Icon name="material-symbols:terminal" width={16} height={16} aria-hidden="true" />
          </a>
          <a id="project-modal-website" href="#" target="_blank" rel="noopener noreferrer" class:list={[actionClass, 'hidden']}>
            <span class="project-label"><span class="project-bracket">[</span> View Website <span class="project-bracket">]</span></span>
            <Icon name="material-symbols:open-in-new" width={16} height={16} aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </dialog>
</section>

<script>
  import { projects } from '../../data/projects';

  // .card-tag lives in global.css, so it also styles these runtime-created nodes.
  const TAG_CLASS = 'card-tag';

  const modal = document.getElementById('project-modal') as HTMLDialogElement | null;
  const get = <T extends HTMLElement>(id: string): T | null => document.getElementById(id) as T | null;

  const titleEl = get('project-modal-title');
  const descriptionEl = get('project-modal-description');
  const imageEl = get<HTMLImageElement>('project-modal-image');
  const placeholderEl = get('project-modal-placeholder');
  const tagsEl = get('project-modal-tags');
  const sourceEl = get<HTMLAnchorElement>('project-modal-source');
  const websiteEl = get<HTMLAnchorElement>('project-modal-website');
  const closeEl = get<HTMLButtonElement>('project-modal-close');

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const CLOSE_MS = 150;
  let opener: HTMLElement | null = null;
  let closeTimer: number | undefined;

  const fill = (index: number): boolean => {
    const project = projects[index];
    if (!project) return false;
    const title = project.title.replaceAll('_', ' ');

    if (titleEl) titleEl.textContent = title;
    if (descriptionEl) descriptionEl.textContent = project.description;

    if (imageEl && placeholderEl) {
      imageEl.hidden = !project.image;
      placeholderEl.hidden = Boolean(project.image);
      if (project.image) {
        imageEl.src = project.image;
        imageEl.alt = project.imageAlt;
      } else {
        placeholderEl.setAttribute('aria-label', project.imageAlt);
      }
    }

    tagsEl?.replaceChildren(
      ...project.tech.map((tag) => {
        const li = document.createElement('li');
        li.className = TAG_CLASS;
        li.textContent = tag;
        return li;
      }),
    );

    if (sourceEl) sourceEl.href = project.href;
    if (websiteEl) {
      // Tailwind class, not the `hidden` attribute: `inline-flex` would override the attribute.
      websiteEl.classList.toggle('hidden', !project.websiteHref);
      websiteEl.href = project.websiteHref ?? '#';
    }
    return true;
  };

  // Lock page scroll without a layout jump from the disappearing scrollbar.
  const lockScroll = (): void => {
    const scrollbar = window.innerWidth - document.documentElement.clientWidth;
    document.documentElement.style.overflow = 'hidden';
    if (scrollbar > 0) document.body.style.paddingRight = `${scrollbar}px`;
  };

  const unlockScroll = (): void => {
    document.documentElement.style.overflow = '';
    document.body.style.paddingRight = '';
  };

  const open = (index: number, trigger: HTMLElement): void => {
    if (!modal || modal.open || !fill(index)) return;
    opener = trigger;
    window.clearTimeout(closeTimer);
    lockScroll();
    modal.dataset.state = '';
    modal.showModal();
    // Next frame, so the pop-up transition starts from the closed state.
    requestAnimationFrame(() => {
      modal.dataset.state = 'open';
    });
  };

  const requestClose = (): void => {
    if (!modal?.open || modal.dataset.state === 'closing') return;
    if (reduceMotion.matches) {
      modal.close();
      return;
    }
    modal.dataset.state = 'closing';
    closeTimer = window.setTimeout(() => modal.close(), CLOSE_MS);
  };

  document.querySelectorAll<HTMLButtonElement>('.project-card-trigger').forEach((button) => {
    button.addEventListener('click', () => open(Number(button.dataset.projectIndex), button));
  });

  closeEl?.addEventListener('click', requestClose);

  // Esc: run the animated close instead of the instant native one.
  modal?.addEventListener('cancel', (event) => {
    event.preventDefault();
    requestClose();
  });

  // The dialog covers the viewport and acts as the backdrop; clicks on the panel never target it.
  modal?.addEventListener('click', (event) => {
    if (event.target === modal) requestClose();
  });

  // Always runs, however the dialog closed.
  modal?.addEventListener('close', () => {
    window.clearTimeout(closeTimer);
    modal.dataset.state = '';
    unlockScroll();
    opener?.focus();
    opener = null;
  });
</script>

<style>
  /* Colors come from the surface tokens in global.css (:root). */
  /* Surface, well and tag styles are the shared .card-* classes in global.css. */
  .project-card {
    cursor: pointer;
  }

  .project-card-footer {
    border-top: 1px solid var(--border-divider);
  }

  /* Multiply with a bottom shade mutes the screenshots' whites so they sit in the dark card. */
  .project-image-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgb(10 10 10 / 0.55) 0%,
      rgb(10 10 10 / 0.15) 40%,
      transparent 70%
    );
    mix-blend-mode: multiply;
    transition: opacity 200ms ease-out;
  }

  .group:hover .project-image-overlay {
    opacity: 0.7;
  }

  .project-placeholder {
    background-color: var(--bg-card-inner);
    background-image:
      radial-gradient(circle at 30% 20%, var(--accent-soft), transparent 55%),
      radial-gradient(circle at 80% 80%, var(--accent-glow), transparent 50%),
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px);
    background-size: 100% 100%, 100% 100%, 24px 24px, 24px 24px;
  }

  /* Modal links "[ View Source ]" / "[ View Website ]": white label, red brackets (same as the card button). */
  .project-action {
    color: var(--text-title);
    letter-spacing: 0.12em;
    transition: color 200ms ease;
  }

  .project-action :global(svg) {
    color: var(--icon-muted);
  }

  .project-action:hover,
  .project-action:focus-visible {
    color: #fff;
  }

  .project-action:hover .project-bracket,
  .project-action:focus-visible .project-bracket {
    color: var(--accent-text-hover);
  }

  /* Hover/focus: label and brackets switch to the shifting-reds effect used in About Me. */
  .project-label {
    display: inline-block;
  }

  .project-card:hover .project-label,
  .project-card:has(.project-card-trigger:focus-visible) .project-label,
  .project-action:hover .project-label,
  .project-action:focus-visible .project-label {
    color: transparent;
    background-image: var(--red-shift-gradient);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .project-card:hover .project-label .project-bracket,
  .project-card:has(.project-card-trigger:focus-visible) .project-label .project-bracket,
  .project-action:hover .project-label .project-bracket,
  .project-action:focus-visible .project-label .project-bracket {
    color: transparent;
  }

  @media (prefers-reduced-motion: no-preference) {
    .project-card:hover .project-label,
    .project-card:has(.project-card-trigger:focus-visible) .project-label,
    .project-action:hover .project-label,
    .project-action:focus-visible .project-label {
      animation: red-shift 0.25s ease-in-out infinite alternate;
    }
  }

  /* Whole card is clickable: the button's hit area is stretched over the card. */
  .project-card-trigger::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .project-card-trigger:focus-visible {
    outline: none;
  }

  /* Keyboard focus lands on the button, but the ring goes on the card it stands for. */
  .project-card:has(.project-card-trigger:focus-visible) {
    border-color: var(--accent-border);
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* "[ View Details ]": white label, red brackets, muted icon. */
  .project-card-trigger {
    color: var(--text-title);
    letter-spacing: 0.12em;
    transition: color 150ms ease-out;
  }

  .project-card-trigger :global(svg) {
    color: var(--icon-muted);
  }

  .project-bracket {
    color: var(--accent-text);
    transition: color 150ms ease-out;
  }

  .project-card:hover .project-card-trigger,
  .project-card:has(.project-card-trigger:focus-visible) .project-card-trigger {
    color: #fff;
  }

  .project-card:hover .project-bracket,
  .project-card:has(.project-card-trigger:focus-visible) .project-bracket {
    color: var(--accent-text-hover);
  }

  .project-modal a.project-action:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .project-modal-panel {
    background-color: var(--bg-card);
    border: 1px solid var(--border-subtle);
  }

  .project-modal-bar {
    border-bottom: 1px solid var(--border-divider);
  }

  .project-modal-close {
    color: var(--text-body);
    transition: color 200ms ease, background-color 200ms ease;
  }

  .project-modal-close:hover,
  .project-modal-close:focus-visible {
    color: var(--accent-text);
    background-color: var(--accent-soft);
  }

  .project-modal-close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }


  .project-modal-description {
    color: var(--text-body);
  }

  /* The dialog itself is the full-screen backdrop; the panel is centered inside it. */
  .project-modal {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    display: none;
    align-items: center;
    justify-content: center;
    background-color: rgb(0 0 0 / 0.7);
    color: inherit;
    opacity: 0;
  }

  .project-modal[open] {
    display: flex;
  }

  .project-modal::backdrop {
    background: transparent;
  }

  .project-modal-panel {
    width: 92vw;
    max-width: 640px;
    max-height: 85vh;
    transform: scale(0.95);
  }

  .project-modal[data-state='open'] {
    opacity: 1;
    transition: opacity 200ms ease-out;
  }

  .project-modal[data-state='open'] .project-modal-panel {
    transform: scale(1);
    transition: transform 200ms ease-out;
  }

  .project-modal[data-state='closing'] {
    opacity: 0;
    transition: opacity 150ms ease-in;
  }

  .project-modal[data-state='closing'] .project-modal-panel {
    transform: scale(0.95);
    transition: transform 150ms ease-in;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-modal[open] {
      opacity: 1;
    }

    .project-modal .project-modal-panel,
    .project-modal[data-state] .project-modal-panel {
      transform: none;
      transition: none;
    }

    .project-modal[data-state] {
      transition: none;
    }
  }
</style>
