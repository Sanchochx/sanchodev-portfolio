---
// `shortLabel` is shown below md so the bar fits a 320px phone.
const links: readonly { href: string; label: string; shortLabel?: string }[] = [
  { href: '#about', label: 'ABOUT ME', shortLabel: 'ABOUT' },
  { href: '#skills', label: 'SKILLS' },
  { href: '#projects', label: 'PROJECTS' },
  { href: '#contact', label: 'CONTACT' },
];
---

<nav
  id="site-nav"
  aria-label="Navegación principal"
  class="reveal-base reveal-slow glass-nav bg-[color:var(--bg-card)] fixed top-6 inset-x-0 mx-auto w-[94%] md:w-[90%] max-w-container-max flex justify-between items-center px-4 md:px-8 py-4 z-50 shadow-[0_0_20px_rgba(0,0,0,0.5)] rounded-none"
>
  <a href="/?desktop" aria-label="Go to the RED LODGE desktop">
    <img
      src="/images/brand/sanchodev_logo.png"
      alt="Sancho Dev logo"
      width="40"
      height="40"
      class="h-10 w-auto"
    />
  </a>

  <ul class="flex gap-3 md:gap-8 items-center list-none m-0 p-0">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            class="font-sans text-[10px] md:text-xs uppercase tracking-wider md:tracking-widest font-medium transition-colors duration-200 text-on-surface/60 hover:text-primary-container"
          >
            {link.shortLabel ? (
              <>
                <span class="md:hidden">{link.shortLabel}</span>
                <span class="hidden md:inline">{link.label}</span>
              </>
            ) : (
              link.label
            )}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  // Scroll to the section without leaving "#id" in the URL.
  document.querySelectorAll<HTMLAnchorElement>('#site-nav a[href^="#"]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const target = document.querySelector(link.getAttribute('href') ?? '');
      if (!target) return;
      event.preventDefault();
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth' });
      history.replaceState(null, '', window.location.pathname + window.location.search);
    });
  });
</script>
