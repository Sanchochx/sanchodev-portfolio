<!-- Welcome window, centered on the desktop: open on every load, closable and draggable.
     Keeps the terminal-* ids because ascii.ts and desktop.css theme it by id. -->
<div
  id="terminal-window"
  role="dialog"
  aria-labelledby="welcome-title"
  class="fixed inset-0 m-auto h-fit max-h-[calc(100vh-7rem)] w-[min(480px,95vw)] bg-black border border-red-900 rounded-sm shadow-2xl z-30 flex flex-col font-mono"
>
  <div id="terminal-titlebar" class="h-8 shrink-0 bg-black flex items-center justify-end px-2 select-none border-b border-red-900 cursor-move touch-none">
    <button id="terminal-close" type="button" aria-label="Close welcome window" class="w-6 h-6 hover:bg-red-500 focus-visible:bg-red-500 text-red-600 hover:text-white flex items-center justify-center text-xs">✕</button>
  </div>
  <script is:inline>
    // Before paint: keep the window invisible until welcome.ts plays its sequence (only when motion is allowed).
    // The timeout only matters if the script bundle fails to load.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var welcomeWin = document.getElementById('terminal-window');
      welcomeWin.classList.add('welcome-pending');
      setTimeout(function () { welcomeWin.classList.remove('welcome-pending'); }, 5000);
    }
  </script>
  <div class="px-4 pt-4 pb-2 text-center">
    <h1 id="welcome-title" data-type class="text-white text-lg font-bold leading-tight">Santiago Sánchez Márquez</h1>
    <p data-type class="rainbow-text text-[13px] mt-1">Software Engineer — AI, DevOps &amp; Cloud</p>
    <p data-type class="text-gray-300 text-[13px] mt-3">Explore the desktop, or jump straight to my work.</p>
    <div id="welcome-cta">
    <a
      href="/portfolio"
      class="welcome-btn inline-block mt-3 mb-2 px-4 py-2 text-sm font-bold tracking-wider rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white transition-colors"
    >
      <span class="rainbow-text">Open Portfolio</span>
    </a>
    </div>
  </div>
  <div class="welcome-accent h-px shrink-0" aria-hidden="true"></div>
  <div class="overflow-auto p-3 selection:bg-green-800 selection:text-white">
    <div class="perspective-container flex items-center justify-center overflow-hidden h-[min(380px,48vh)]">
      <div id="ascii-spinner">
        <pre id="ascii-content" aria-label="ASCII art" class="rainbow-text transition-opacity duration-300 font-mono leading-none tracking-normal whitespace-pre">
   _____                  __               ____
