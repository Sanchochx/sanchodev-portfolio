---
import type { DesktopIconData } from '../../data/desktopApps';

type Props = DesktopIconData;
const { id, label, icon, alt, href } = Astro.props;

const FALLBACK_ICON = '/images/brand/sanchodev_logo.png';
const Tag = href ? 'a' : 'button';
const tagProps = href ? { href } : { type: 'button' as const };
---

<Tag
  id={id}
  {...tagProps}
  class="w-20 flex flex-col items-center justify-start group rounded-sm border border-transparent hover:bg-blue-500/20 hover:border-blue-400/30 focus-visible:border-blue-400/60 transition-colors p-1 cursor-pointer z-20"
>
  <div class="relative w-9 h-9 mb-1">
    <img
      src={icon}
      alt={alt}
      width="36"
      height="36"
      class="w-full h-full object-contain drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]"
      onerror={`this.onerror=null;this.src='${FALLBACK_ICON}'`}
    />
    <!-- Flechita de acceso directo (estilo clásico) -->
    <div class="absolute -bottom-1 -left-1 w-3 h-3 bg-white border border-gray-400 flex items-center justify-center shadow-sm">
      <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#0066cc" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 5l7 7-7 7" />
        <path d="M17 12H3" />
      </svg>
    </div>
  </div>
  <span class="text-white text-[9px] text-center font-mono tracking-wider drop-shadow-[0_1px_3px_rgba(0,0,0,1)] px-1 leading-tight mt-1">
    {label}
  </span>
</Tag>
