---
import type { DesktopIconData } from '../../data/desktopApps';

type Props = DesktopIconData;
const { id, label, icon, alt, href, featured = false } = Astro.props;

const FALLBACK_ICON = '/images/brand/sanchodev_logo.png';
const Tag = href ? 'a' : 'button';
const tagProps = href ? { href } : { type: 'button' as const };
const ariaLabel = href ? `Go to ${label}` : `Open ${label}`;
---

<Tag
  id={id}
  {...tagProps}
  aria-label={ariaLabel}
  class:list={[
    'flex flex-col items-center justify-start group rounded-sm border border-transparent hover:bg-blue-500/20 hover:border-blue-400/30 focus-visible:border-blue-400/60 focus-visible:bg-blue-500/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-500 transition-colors p-1 cursor-pointer z-20',
    'w-24',
  ]}
>
  <div class:list={['relative mb-1', featured ? 'w-9 h-9' : 'w-8 h-8']}>
    <img
      src={icon}
      alt={alt}
      width={featured ? 36 : 32}
      height={featured ? 36 : 32}
      class="w-full h-full object-contain drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]"
      onerror={`this.onerror=null;this.src='${FALLBACK_ICON}'`}
    />
    <!-- Flechita de acceso directo (estilo clásico) -->
    <div class="absolute -bottom-1 -left-1 w-3 h-3 bg-white border border-gray-400 flex items-center justify-center shadow-sm">
      <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="#0066cc" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 5l7 7-7 7" />
        <path d="M17 12H3" />
      </svg>
    </div>
  </div>
  <span class="text-white text-[12px] text-center font-mono break-normal rounded-sm drop-shadow-[0_1px_3px_rgba(0,0,0,1)] leading-tight mt-1">
    {label}
  </span>
</Tag>
