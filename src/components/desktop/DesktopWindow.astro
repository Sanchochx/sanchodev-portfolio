---
interface Props {
  name: string;
  title?: string;
  icon?: string;
  closeLabel: string;
  draggable?: boolean;
  rainbowClose?: boolean;
  class?: string;
}

const { name, title, icon, closeLabel, draggable = false, rainbowClose = false, class: className = '' } = Astro.props;
---

<div
  id={`${name}-window`}
  class:list={['hidden fixed inset-0 m-auto bg-black border border-red-900 rounded-sm shadow-2xl flex flex-col', className]}
>
  <div
    id={draggable ? `${name}-titlebar` : undefined}
    class:list={['h-8 shrink-0 bg-black flex items-center justify-between px-2 select-none border-b border-red-900', draggable && 'cursor-move touch-none']}
  >
    <div class="flex items-center text-red-600 text-xs font-mono tracking-wider truncate">
      {icon && <img src={icon} alt="" width="16" height="16" class="w-4 h-4 mr-2" onerror="this.style.display='none'" />}
      {title}
      <slot name="title" />
    </div>
    <button
      id={`${name}-close`}
      type="button"
      aria-label={closeLabel}
      class="w-6 h-6 hover:bg-red-500 focus-visible:bg-red-500 text-red-600 hover:text-white flex items-center justify-center text-xs"
    >
      {rainbowClose ? <span class="rainbow-text">✕</span> : '✕'}
    </button>
  </div>
  <slot />
</div>
