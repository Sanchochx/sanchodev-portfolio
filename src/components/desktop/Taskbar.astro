---
---

<!-- Barra de Tareas (Taskbar) -->
<div class="absolute bottom-0 left-0 w-full h-12 bg-black/80 backdrop-blur-md border-t border-red-900/50 flex items-center justify-end px-2 select-none z-50">

  <!-- Reloj del Sistema -->
  <div class="flex items-center h-full text-gray-300 font-mono text-sm">
    <div id="os-clock" class="h-full flex items-center cursor-default whitespace-pre">
      <span id="os-clock-time" class="red-text h-full px-4 flex items-center">--:--</span>
      <span id="os-clock-date" class="red-text h-full px-4 flex items-center border-l border-red-900/30"></span>
    </div>
  </div>
</div>
