---
import DesktopWindow from '../DesktopWindow.astro';
---

<DesktopWindow name="pactasis" title="P.A.C.T.A.S.I.S v1.0" closeLabel="Cerrar P.A.C.T.A.S.I.S" draggable class="h-[min(350px,calc(100vh-4rem))] w-[min(500px,95vw)] z-40 font-mono overflow-hidden">
  <span slot="title" class="ml-2 w-2 h-2 rounded-full bg-green-500 shadow-[0_0_6px_rgba(34,197,94,0.9)]" role="img" aria-label="En línea"></span>
  <div id="pactasis-chat-log" role="log" aria-live="polite" class="flex-1 p-4 overflow-y-auto text-xs leading-relaxed tracking-wider space-y-1"></div>

  <form id="pactasis-form" class="shrink-0 flex items-center px-2 py-1 border-t border-red-900 bg-black">
    <span class="text-red-600 mr-2 font-bold" aria-hidden="true">&gt;</span>
    <input
      type="text"
      id="pactasis-input"
      aria-label="Comando para P.A.C.T.A.S.I.S"
      maxlength="2000"
      class="flex-1 bg-transparent text-red-500 outline-none font-mono text-xs tracking-wider caret-red-500"
      autocomplete="off"
      spellcheck="false"
    />
  </form>
</DesktopWindow>
